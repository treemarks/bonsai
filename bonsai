DENIED_TOOLS = DISALLOWED_TOOLS + ("Read",)
# A literal floor beside the list: shrinking DISALLOWED_TOOLS must not open the lane.
MUST_DENY = ("Bash", "Agent", "Task", "WebSearch", "WebFetch", "Write", "Edit", "MultiEdit",
             "NotebookEdit", "Glob", "Grep", "Read", "Skill")
PERMISSION_MODE = "dontAsk"
# Claude CLI flags that grant a tool, a folder, a server, settings, agents or an earlier session.
CLAUDE_REOPENING_FLAGS = tuple("--" + name for name in (
    "allowedTools", "allowed-tools", "add-dir", "mcp-config", "settings", "plugin-dir",
    "agents", "dangerously-skip-permissions", "allow-dangerously-skip-permissions",
    "resume", "continue", "fork-session", "ide", "chrome",
))
# The one `--settings` value a Bonsai job may pass: it turns hooks off, so a personal login's own ~/.claude hooks do
# not run on a routed job. It grants nothing. (The fleet's lanes run under pool folders that carry no hooks.)
HOOKS_OFF = '{"disableAllHooks":true}'
# Codex CLI flags that lift the sandbox or the approval policy, add a writable folder, attach a file, run hooks,
# move the session into a worktree, or layer a profile's config over the base.
CODEX_REOPENING_FLAGS = tuple("--" + name for name in (
    "dangerously-bypass-approvals-and-sandbox", "full-auto", "yolo", "add-dir", "search",
    "oss", "enable", "image", "approve-for-me", "dangerously-bypass-hook-trust", "worktree", "profile",
))
CODEX_SHORT_REOPENING = ("-i", "-p")
CODEX_REQUIRED_CONFIG = ('web_search="disabled"',)
# The one search a Bonsai job may have, when its user asks for it (`--web`, no files): OpenAI's cached index, never
# live pages, so a planted page cannot carry the task to a site of its choosing. The fleet never sends it.
CODEX_WEB_SEARCH = 'web_search="cached"'
# The fleet's lanes also require approval_policy="never". A Bonsai job sends no approval policy: an institution's
# managed Codex pins its own (one university's warns that `approval_policy` is "disallowed by enterprise-managed
# requirements", and the fleet recorded a managed account refusing startup under `never`, #4317), and Bonsai 0.2.5,
# which sent none, ran on such a seat. With the shell tool off there is nothing to approve. A policy, when given,
# may only be "never".
CODEX_APPROVAL = 'approval_policy="never"'
CODEX_REQUIRED_FLAGS = ("--ephemeral", "--ignore-user-config", "--ignore-rules")
_CONTEXT_MARKERS = (".git", ".claude", ".mcp.json", "CLAUDE.md", "AGENTS.md", ".agents", ".codex")
_HOME_CONFIG = (".claude", ".codex")
CWD_PREFIX = "bonsai-job-"
# The home folder's .agents holds Codex's user skills (`bonsai install-skill` writes one there), read wherever a call
# starts, so holding it adds nothing to a job: allowed in the home folder like .claude and .codex. That matters where
# a job's temp folder sits inside home: always on Windows, and on a Mac whose TMPDIR is under home (a CI runner's).
_HOME_SKILLS = (".agents",)


class LaunchRefused(RuntimeError):
    """The command is not a text-only call; nothing was spawned."""


def claude_args(max_turns: int = TEXT_ONLY_TURNS) -> list:
    """The flags of one text-only `claude -p` call, last in the command (the prompt rides stdin)."""
    if int(max_turns) < 1:
        raise ValueError("max_turns must be at least 1")
    return ["--permission-mode", PERMISSION_MODE, "--tools", "", "--disallowedTools", ",".join(DENIED_TOOLS),
            "--max-turns", str(int(max_turns)), "--strict-mcp-config", "--disable-slash-commands",
            "--no-session-persistence", "--safe-mode"]


def codex_args(cwd: str, web: bool = False) -> list:
    """The flags of one text-only `codex exec` call, after `exec`: the read-only sandbox, the shell off, nothing of
    the user's config or rules, no web search (the cached index when `web`), the one empty working folder."""
    return ["--skip-git-repo-check", "-C", cwd, "-s", "read-only", "--disable", "shell_tool",
            *CODEX_REQUIRED_FLAGS, "-c", CODEX_WEB_SEARCH if web else CODEX_REQUIRED_CONFIG[0]]


def env_additions() -> dict:
    return {"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"}


@contextlib.contextmanager
def private_cwd():
    """A fresh empty working folder for one call, outside every checkout, removed afterwards."""
    with tempfile.TemporaryDirectory(prefix=CWD_PREFIX) as tmp:
        yield os.path.realpath(tmp)


def _cwd_problems(cwd, allowed_files: tuple = ()) -> list:
    if not cwd:
        return ["no working folder is given (the call would run in the caller's own folder)"]
    path = Path(os.path.realpath(str(cwd)))
    if not path.is_dir():
        return ["the working folder does not exist"]
    problems = []
    extra = sorted(name for name in os.listdir(path) if name not in allowed_files)
    if extra:
        problems.append("the working folder is not empty (%d entries it should not hold)" % len(extra))
    home = Path(os.path.realpath(Path.home()))
    for folder in (path, *path.parents):
        markers = [m for m in _CONTEXT_MARKERS if not (folder == home and m in _HOME_CONFIG + _HOME_SKILLS)]
        held = [m for m in markers if (folder / m).exists()]
        if held:
            problems.append("the working folder sits in or under a folder holding %s" % ", ".join(held)
                            + (" (on Windows a job's folder is inside your home folder: move %s into .claude or .codex"
                               " there, or set TEMP to a folder outside it)" % ", ".join(held) if folder == home else ""))
            break
    return problems


def _values(cmd: list, flag: str) -> list:
    return [cmd[i + 1] if i + 1 < len(cmd) else "" for i, arg in enumerate(cmd) if arg == flag]


def _cli_body(cmd) -> list:
    """The command from the CLI's own name on: an npm install on Windows starts as `node <the CLI's script>`."""
    a = [str(x) for x in (cmd or [])]
    npm_codex = os.path.join("node_modules", "@openai", "codex", "bin", "codex.js").lower()
    if len(a) > 1 and os.path.basename(a[0]).lower() == "node.exe" and a[1].lower().endswith(os.sep + npm_codex):
        return ["codex"] + a[2:]
    return a


def claude_problems(cmd, cwd) -> list:
    """Why `cmd`, run from `cwd`, is not a text-only `claude -p` call. Empty when it is one."""
    a = _cli_body(cmd)
    problems = []
    if any("bypassPermissions" in arg for arg in a):
        problems.append("permissions are bypassed")
    if _values(a, "--permission-mode") != [PERMISSION_MODE]:
        problems.append("the permission mode is not %s, once" % PERMISSION_MODE)
    if _values(a, "--tools") != [""]:
        problems.append("the built-in tool list is not empty, once")
    denied = set()
    for value in _values(a, "--disallowedTools") + _values(a, "--disallowed-tools"):
        denied.update(t.strip() for t in value.split(",") if t.strip())
    missing = sorted((set(DENIED_TOOLS) | set(MUST_DENY)) - denied)
    if missing:
        problems.append("%d tools are not named denials (%s)" % (len(missing), ", ".join(missing)))
    settings = _values(a, "--settings")
    if settings and settings != [HOOKS_OFF]:
        problems.append("--settings carries something other than turning hooks off")
    reopening = [flag for flag in CLAUDE_REOPENING_FLAGS if flag != "--settings"
                 and any(arg == flag or arg.startswith(flag + "=") for arg in a)]
    reopening += ["--settings="] if any(arg.startswith("--settings=") for arg in a) else []
    if reopening:
        problems.append("the command grants a tool, folder, server, settings or session (%s)" % ", ".join(reopening))
    for flag, what in (("--strict-mcp-config", "MCP servers are not restricted"),
                       ("--disable-slash-commands", "slash commands and skills are not disabled"),
                       ("--no-session-persistence", "the session would be kept on disk"),
                       ("--safe-mode", "the login's own CLAUDE.md, skills, plugins and hooks would load")):
        if flag not in a:
            problems.append(what)
    turns = _values(a, "--max-turns")
    if len(turns) != 1 or not turns[0].isdigit() or int(turns[0]) < 1:
        problems.append("the turns are not bounded")
    if "-p" not in a and "--print" not in a:
        problems.append("the call is not a headless one")
    return problems + _cwd_problems(cwd)


def codex_problems(cmd, cwd, web: bool = False) -> list:
    """Why `cmd` is not a text-only `codex exec` call (with only the cached search when `web`). Empty when it is one."""
    a = _cli_body(cmd)
    problems = []
    if a[1:2] != ["exec"]:
        problems.append("the call is not codex exec")
    if (_values(a, "--sandbox") + _values(a, "-s")) != ["read-only"]:
        problems.append("the sandbox is not read-only, once")
    config = _values(a, "-c") + _values(a, "--config")
    for needed in ((CODEX_WEB_SEARCH,) if web else CODEX_REQUIRED_CONFIG):
        if needed not in config:
            problems.append("%s is not set" % needed)
    if not web and any(c.replace(" ", "") == "features.code_mode_host=true" for c in config):
        problems.append("the code-mode host is turned on without a web search asked for")
    if any(c.split("=", 1)[0].strip() == "approval_policy" and c.replace(" ", "") != CODEX_APPROVAL for c in config):
        problems.append("an approval policy other than never is set")
    for key in ("approval_policy", "web_search", "sandbox_mode", "sandbox_permissions"):
        if len([c for c in config if c.split("=", 1)[0].strip() == key]) > 1:
            problems.append("%s is set more than once" % key)
    if any(c.split("=", 1)[0].strip() in ("sandbox_mode", "sandbox_permissions") for c in config):
        problems.append("the sandbox is set by config as well as by flag")
    if "shell_tool" not in _values(a, "--disable"):
        problems.append("the shell tool is not disabled")
    for flag in CODEX_REQUIRED_FLAGS:
        if flag not in a:
            problems.append("%s is missing" % flag)
    reopening = [flag for flag in CODEX_REOPENING_FLAGS if any(arg == flag or arg.startswith(flag + "=") for arg in a)]
    reopening += sorted({arg for arg in a if any(arg.startswith(f) and not arg.startswith("--") for f in CODEX_SHORT_REOPENING)})
    if reopening:
        problems.append("the command lifts the sandbox or adds a folder (%s)" % ", ".join(reopening))
    folders = _values(a, "--cd") + _values(a, "-C")
    if len(folders) != 1 or os.path.realpath(folders[0]) != os.path.realpath(str(cwd or "")):
        problems.append("the command does not name its one working folder")
    return problems + _cwd_problems(cwd)


def usage_read_args() -> list:
    """The flags of a `claude -p` that only asks for `/usage`: every flag of a text-only call but the one that turns
    slash commands off (the read is one). Were "/usage" ever taken as a prompt, it would be one turn with no tool, no
    server, no hook and an empty folder."""
    return [a for a in claude_args(max_turns=1) if a != "--disable-slash-commands"]


def require_usage_read(cmd, cwd) -> None:
    """The text-only guard for a `/usage` read: everything but the slash-command check."""
    problems = [p for p in claude_problems(cmd, cwd) if p != "slash commands and skills are not disabled"]
    if problems:
        raise LaunchRefused("the claude usage read is not a text-only call, nothing was started: %s" % "; ".join(problems))


def require(provider: str, cmd, cwd, web: bool = False) -> None:
    """Refuse, before anything is spawned, a job command that is not a text-only call."""
    if web and provider == "claude":
        raise LaunchRefused("a claude job has no web search, nothing was started")
    problems = claude_problems(cmd, cwd) if provider == "claude" else codex_problems(cmd, cwd, web)
    if problems:
        raise LaunchRefused("the %s job is not a text-only call, nothing was started: %s" % (provider, "; ".join(problems)))



def _sysctl(name: str) -> str:
    try:
        return subprocess.run(["sysctl", "-n", name], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def machine_stats() -> dict:
    """This machine's row. macOS reads the stock tools (sysctl, vm_stat, pmset). Windows reads
    the kernel through ctypes: memory, battery and uptime, no CPU figure yet. Anything a platform
    cannot read is left out and the board prints `·`."""
    st: dict = {"host": socket.gethostname().split(".")[0]}
    if IS_WIN:
        return _machine_stats_windows(st)
    try:
        ncpu = os.cpu_count() or 1
        st["cpu"] = min(100.0, os.getloadavg()[0] / ncpu * 100.0)
    except Exception:
        pass
    if not IS_MAC:
        return st
    try:
        total = int(_sysctl("hw.memsize"))
        vm = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=5).stdout
        page = int(re.search(r"page size of (\d+)", vm).group(1))
        free = 0
        for key in ("Pages free", "Pages inactive", "Pages speculative"):
            m = re.search(key + r":\s+(\d+)", vm)
            if m:
                free += int(m.group(1)) * page
        st["mem"] = 100.0 * (total - free) / total
    except Exception:
        pass
    m = re.search(r"used = ([\d.]+)M", _sysctl("vm.swapusage"))
    if m:
        st["swap_gb"] = float(m.group(1)) / 1024.0
    try:
        batt = subprocess.run(["pmset", "-g", "batt"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"(\d+)%;\s*(\w[\w ]*?);", batt)
        if m:
            st["batt"] = int(m.group(1))
            st["ac"] = "AC" in batt.split("\n")[0] or m.group(2) in ("charging", "charged", "finishing charge")
    except Exception:
        pass
    try:
        st["uptime"] = _now() - float(re.search(r"sec = (\d+)", _sysctl("kern.boottime")).group(1))
    except Exception:
        pass
    return st


def _machine_stats_windows(st: dict) -> dict:
    """Provisional and untested on a real Windows machine (the Windows release is later):
    GlobalMemoryStatusEx, GetSystemPowerStatus and GetTickCount64 through ctypes."""
    try:
        import ctypes
        from ctypes import wintypes

        class MEMORYSTATUSEX(ctypes.Structure):
            _fields_ = [("dwLength", wintypes.DWORD), ("dwMemoryLoad", wintypes.DWORD),
                        ("ullTotalPhys", ctypes.c_ulonglong), ("ullAvailPhys", ctypes.c_ulonglong),
                        ("ullTotalPageFile", ctypes.c_ulonglong), ("ullAvailPageFile", ctypes.c_ulonglong),
                        ("ullTotalVirtual", ctypes.c_ulonglong), ("ullAvailVirtual", ctypes.c_ulonglong),
                        ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]
        m = MEMORYSTATUSEX()
        m.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
        if ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m)):
            st["mem"] = float(m.dwMemoryLoad)
            st["swap_gb"] = max(0.0, (m.ullTotalPageFile - m.ullAvailPageFile) - (m.ullTotalPhys - m.ullAvailPhys)) / 2**30

        class SYSTEM_POWER_STATUS(ctypes.Structure):
            _fields_ = [("ACLineStatus", ctypes.c_ubyte), ("BatteryFlag", ctypes.c_ubyte),
                        ("BatteryLifePercent", ctypes.c_ubyte), ("Reserved1", ctypes.c_ubyte),
                        ("BatteryLifeTime", wintypes.DWORD), ("BatteryFullLifeTime", wintypes.DWORD)]
        p = SYSTEM_POWER_STATUS()
        if ctypes.windll.kernel32.GetSystemPowerStatus(ctypes.byref(p)) and p.BatteryLifePercent != 255:
            st["batt"] = int(p.BatteryLifePercent)
            st["ac"] = p.ACLineStatus == 1
        ctypes.windll.kernel32.GetTickCount64.restype = ctypes.c_ulonglong
        st["uptime"] = ctypes.windll.kernel32.GetTickCount64() / 1000.0
    except Exception:
        pass
    return st



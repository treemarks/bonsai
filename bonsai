def _now() -> float:
    return time.time()


def _iso(ts: float) -> str:
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _when_ts(v) -> float | None:
    """A provider timestamp (epoch seconds, epoch milliseconds or ISO-8601) as epoch seconds,
    or None when it is not finite or not between 2000 and 2100."""
    if v is None or isinstance(v, bool):
        return None
    x = None
    if isinstance(v, (int, float)):
        x = float(v)
        if not math.isfinite(x):
            return None
        if x > 1e11:
            x = x / 1000.0
    elif isinstance(v, str):
        s = v.strip()
        if re.fullmatch(r"\d+(\.\d+)?", s):
            return _when_ts(float(s))
        try:
            if s.endswith("Z"):
                s = s[:-1] + "+00:00"
            x = dt.datetime.fromisoformat(s).timestamp()
        except ValueError:
            return None
    if x is None or not (946684800 <= x <= 4102444800):
        return None
    return x


def _age(seconds: float | None) -> str:
    """Whole minutes at least, never seconds (ruled 2026-10-28: "the minimum unit of granularity
    anywhere should be a minute")."""
    if seconds is None or (isinstance(seconds, float) and not math.isfinite(seconds)):
        return "·"
    s = max(0, int(seconds))
    if s < 60:
        return "<1m"
    m = s // 60
    if m < 60:
        return "%dm" % m
    h = m // 60
    if h < 24:
        return "%dh%02dm" % (h, m % 60)
    d = h // 24
    return "%dd%dh" % (d, h % 24)


def _pct(v) -> float | None:
    """A provider's utilization as a 0-100 number rounded to a tenth, or None when it is not a finite
    number (a string, a bool, NaN). Both providers report 0-100 (verified 2026-08-07: a claude five_hour
    of 1.0 is 1% used; the retired "<=1 means a fraction" heuristic misread exactly that value as 100%)."""
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
        return None
    return round(max(0.0, min(100.0, float(v))), 1)


def _jwt_claims(tok: str) -> dict:
    """A JWT's claims, decoded locally for labels and expiry checks only (no signature check, never an
    authorization decision)."""
    try:
        payload = tok.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
        return claims if isinstance(claims, dict) else {}
    except Exception:
        return {}



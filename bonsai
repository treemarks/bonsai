def probe_all(cfg: dict, previous: dict | None = None) -> dict:
    """Every pool, once; a login that stops answering keeps its last good numbers beside its new state."""
    prev_rows = {(r.get("provider"), r.get("pool")): r for r in (previous or {}).get("rows", []) if isinstance(r, dict)}
    rows = []
    for provider, pool, d in discover_pools():
        old = prev_rows.get((provider, pool)) or {}
        row = behavior(provider)["probe"](pool, d, cfg)
        good = ({k: old.get(k) for k in ("5h", "5h_at", "wk", "wk_at", "plan", "account")}
                if old.get("state") in ("OK", "LIMITED", "signed-in") else old.get("last_good"))
        if row["state"] not in ("OK", "LIMITED", "signed-in") and good:
            row["last_good"] = good                # kept across failures; a signed-in Claude login counts as having worked
        rows.append(row)
    return annotate({"at": _now(), "rows": rows}, cfg)



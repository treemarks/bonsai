class Paint:
    def __init__(self, color: bool):
        self.on = color

    def c(self, code: str, s: str) -> str:
        return "\033[%sm%s\033[0m" % (code, s) if self.on else s

    def green(self, s): return self.c("32", s)
    def yellow(self, s): return self.c("33", s)
    def red(self, s): return self.c("31", s)
    def dim(self, s): return self.c("2", s)
    def bold(self, s): return self.c("1", s)


def level_color(p: Paint, left: float | None, s: str) -> str:
    if left is None:
        return s
    return p.green(s) if left >= 50 else p.yellow(s) if left >= 20 else p.red(s)


def bar(left: float | None, width: int) -> str:
    if left is None:
        return "·" * width
    full = int(round(left / 100.0 * width))
    return "█" * full + "░" * (width - full)


def _vis(s: str) -> int:
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def _fixw(s: str, w: int) -> str:
    return s + " " * max(0, w - _vis(s))


def render(state: dict, cfg: dict, p: Paint, width: int, interval: int) -> str:
    rows = sorted([r for r in state.get("rows", []) if isinstance(r, dict)],
                  key=lambda r: (r.get("state") not in ("OK", "LIMITED", "signed-in"),
                                 r.get("wk_at") if r.get("wk_at") is not None else float("inf")))
    age = _now() - (state.get("at") or _now())
    lines = []
    head = p.bold("ACCOUNTS") + "   " + p.dim("ant = Claude   oai = Codex   ⌂ = institution seat")
    right = p.dim("as of %s ago   refresh in %s" % (_age(age), _age(max(0, interval - age))))
    pad = max(1, width - _vis(head) - _vis(right))
    lines.append(head + " " * pad + right)
    bw = max(8, min(24, width - 74))
    lines.append(p.dim("  %-15s %-3s %s %-5s %-7s %-5s %-7s %-8s %s" % (
        "LOGIN", "VIA", " " * bw, "%LEFT", "RESET", "5H", "RESET", "PLAN", "STATE")))
    if not rows:
        lines.append("  " + p.dim("no logins set up: `bonsai login <email> --claude` or `--codex`"))
    for r in rows:
        q = r if r.get("state") in ("OK", "LIMITED") else (r.get("last_good") or {})
        wk_left = (100.0 - q["wk"]) if isinstance(q.get("wk"), (int, float)) else None
        fh_left = (100.0 - q["5h"]) if isinstance(q.get("5h"), (int, float)) else None
        name = ("⌂" if r.get("institution") else " ") + display_text(r.get("name") or r.get("pool", "?"), 14)
        via = PROVIDER_LABEL.get(r.get("provider"), display_text(r.get("provider"), 3))
        state_s = display_text(r.get("state", "?"), 16)
        if state_s == "OK":
            state_s = p.dim("ok")
        elif state_s == "LIMITED":
            state_s = p.red("limited")
        elif state_s in ("re-login", "token-expired", "no-plan", "locked", "keychain-timeout", "signed-in", "unknown"):
            state_s = p.yellow(state_s)
        else:
            state_s = p.red(state_s)
        wk_reset = _age(q["wk_at"] - _now()) if isinstance(q.get("wk_at"), (int, float)) else "·"
        fh_reset = _age(q["5h_at"] - _now()) if isinstance(q.get("5h_at"), (int, float)) else "·"
        lines.append("  %-15s %-3s %s %s %-7s %s %-7s %-8s %s" % (
            name, via, level_color(p, wk_left, bar(wk_left, bw)),
            _fixw(level_color(p, wk_left, "%.0f%%" % wk_left) if wk_left is not None else "·", 5),
            wk_reset,
            _fixw(level_color(p, fh_left, "%.0f%%" % fh_left) if fh_left is not None else "·", 5),
            fh_reset, display_text(q.get("plan") or r.get("plan") or "·", 8), state_s))
    lines.append("")
    m = machine_stats()
    jobs = read_jobs()
    running = [j for j in jobs if "exit" not in j and not j.get("lost")]
    done = [j for j in jobs if "exit" in j]
    act = ("job×%d %s" % (len(running), display_text(running[-1].get("label", ""), 14))) if running else "idle"
    last = ""
    if done:
        d = done[-1]
        fin = _when_ts(d.get("finished_at")) or ((_when_ts(d.get("at")) or _now()) + float(d.get("seconds") or 0))
        last = "last: %s %s %s ago" % (display_text(d.get("label", ""), 14),
                                       "ok" if d.get("exit") == 0 else "exit %s" % display_text(d.get("exit"), 4),
                                       _age(_now() - fin))
    lines.append(p.bold("MACHINE") + "    " + p.dim("%-24s %-6s %-6s %-6s %-9s %-8s %s" % (
        "ACTIVITY", "LOAD", "MEM%", "SWAP", "BATT", "UP", "")))
    batt = "·"
    if m.get("batt") is not None:
        ac = m.get("ac")
        batt = "%d%% %s" % (m["batt"], "ac" if ac else "batt" if ac is False else "?")
        if ac is False:
            batt = level_color(p, float(m["batt"]), batt)
    lines.append("  %-10s %-24s %-6s %-6s %-6s %s %-8s %s" % (
        display_text(m.get("host", "?"), 10), act[:24],
        ("%.1f" % m["load"]) if m.get("load") is not None else "·",
        ("%.0f%%" % m["mem"]) if m.get("mem") is not None else "·",
        ("%.0fGB" % m["swap_gb"]) if m.get("swap_gb") is not None else "·",
        _fixw(batt, 9), _age(m.get("uptime")), p.dim(last)))
    return "\n".join(lines)


def _wait_for_key(seconds: float) -> bool:
    """True when the user presses q; otherwise returns after `seconds`."""
    if not sys.stdin.isatty():
        time.sleep(seconds)
        return False
    if IS_WIN:
        import msvcrt
        end = _now() + seconds
        while _now() < end:
            if msvcrt.kbhit() and msvcrt.getwch().lower() == "q":
                return True
            time.sleep(0.1)
        return False
    import select
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        r, _, _ = select.select([sys.stdin], [], [], seconds)
        if r:
            return sys.stdin.read(1).lower() == "q"
        return False
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def cmd_gauge(a, cfg) -> int:
    p = Paint(not a.no_color and sys.stdout.isatty())
    interval = max(180, int(a.interval or cfg.get("interval") or DEFAULT_INTERVAL))
    cfg = {**cfg, "interval": interval}
    if a.once:
        state = refresh(cfg, force=a.fresh)
        print(render(state, cfg, p, shutil.get_terminal_size((100, 30)).columns, interval))
        return 0
    try:
        force = a.fresh
        while True:
            state = refresh(cfg, force=force)
            force = False
            sys.stdout.write("\033[H\033[2J" if p.on else "\n")
            print(render(state, cfg, p, shutil.get_terminal_size((100, 30)).columns, interval))
            print(p.dim("\nq or Ctrl-C quits · bonsai route · bonsai job <target> \"...\" · bonsai pass astra -f <file>"))
            sys.stdout.flush()
            if _wait_for_key(5):
                return 0
    except KeyboardInterrupt:
        print()
        return 0



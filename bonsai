class _Lines:
    """Lines from a child's standard output, read on a thread so a deadline holds whatever the child's output
    buffering does (a reply that arrives together with the one before it is never lost in a buffer a `select` cannot
    see). The thread reads the raw descriptor in short timed reads, so a stop is always heard, and a stream is closed
    only once its thread has finished with it: shutting a reader down never waits on a child that keeps its output
    open. (Windows pipes take no timed read: there a reader still blocked at shutdown is left to end with the pipe.)"""

    LINE_LIMIT = 1 << 20          # one line; a longer one is dropped, and nothing of it parses
    QUEUED = 256                  # lines held at once; past that the child waits on its own write

    def __init__(self, stream):
        self.stream = stream
        self.fd = stream.fileno()
        self.q = queue.Queue(maxsize=self.QUEUED)
        self.dropping = threading.Event()   # keep reading, keep nothing: a server finishing its writes is never blocked
        self.stopping = threading.Event()   # stop reading altogether (once the server is done)
        self.t = threading.Thread(target=self._pump, daemon=True)
        self.t.start()

    def _put(self, item) -> bool:
        while not self.stopping.is_set() and not self.dropping.is_set():
            try:
                self.q.put(item, timeout=0.1)
                return True
            except queue.Full:
                continue
        return False

    def _pump(self):
        pending = b""
        try:
            while not self.stopping.is_set():
                if not IS_WIN:
                    ready, _, _ = select.select([self.fd], [], [], 0.1)
                    if not ready:
                        continue
                chunk = os.read(self.fd, 65536)
                if not chunk:
                    break
                pending += chunk
                while b"\n" in pending:
                    line, pending = pending.split(b"\n", 1)
                    if len(line) <= self.LINE_LIMIT and not self.dropping.is_set() and not self._put(line + b"\n") \
                            and self.stopping.is_set():
                        return
                if len(pending) > self.LINE_LIMIT:
                    pending = b""                          # a line past the limit: dropped, never parsed
        except (OSError, ValueError):
            pass
        if pending and len(pending) <= self.LINE_LIMIT:
            self._put(pending)
        try:
            self.q.put_nowait(b"")
        except queue.Full:
            pass

    def readline(self, deadline: float):
        """The next line; b"" at the end of the output; None once the deadline has passed, however much is queued."""
        left = deadline - _now()
        if left <= 0:
            return None
        try:
            return self.q.get(timeout=left)
        except queue.Empty:
            return None

    def discard(self):
        """Stop keeping what arrives, but go on reading it: a server that is still writing as it shuts down is never
        blocked on a full pipe, so it reaches its own exit."""
        self.dropping.set()
        try:
            while True:
                self.q.get_nowait()
        except queue.Empty:
            pass

    def close(self, wait: float = 1.0):
        """Stop reading (the server is done), and close the stream once the thread has finished with it (within
        `wait`); never waits longer."""
        self.discard()
        self.stopping.set()
        self.t.join(wait)
        if not self.t.is_alive():
            try:
                self.stream.close()
            except (OSError, ValueError):
                pass


def _stop_server(p, supervised: bool, cleanup_timeout: float, on_exit) -> None:
    """Ask a server to stop by closing its standard input (the app-server exits at once on that).

    Under a supervisor that exit is waited for, up to `cleanup_timeout`, and only that exit's code is trusted: the
    supervisor reports a storage or cleanup failure as 74 when its child ends by itself, but answers 143 to a TERM
    whatever its cleanup did. So a supervised server that will not end by itself is sent TERM (never a kill: its
    children's cleanup runs on TERM) and reported to `on_exit(None)`, an unverified stop. An unsupervised one gets a
    second's grace, then TERM, then a kill. `on_exit(returncode)` may raise."""
    try:
        p.stdin.close()
    except Exception:
        pass
    try:
        p.wait(timeout=cleanup_timeout if supervised else 1.0)
    except subprocess.TimeoutExpired:
        p.terminate()
        try:
            p.wait(timeout=cleanup_timeout if supervised else 5.0)
        except subprocess.TimeoutExpired:
            if not supervised:
                p.kill()
                try:
                    p.wait(timeout=5.0)
                except subprocess.TimeoutExpired:
                    pass
        if supervised:
            if on_exit is not None:
                on_exit(None)
            return
    if on_exit is not None:
        on_exit(p.returncode)


def codex_rpc(env: dict, method: str, params: dict | None = None, timeout: float = 25.0,
              client: tuple = ("poolcore", "1"), wrap=None, on_exit=None, cleanup_timeout: float = 20.0):
    """One request to Codex's own app-server (`codex app-server`, JSON-RPC over stdio) under `env`
    (its CODEX_HOME names the pool). Codex holds and refreshes the credential; the request carries none of it.
    `wrap(argv)` may return the argv to start instead (a caller under a storage supervisor passes its
    guard; the supervised process is then stopped by its input closing and never killed, and `on_exit` hears its
    own exit code, or None when it would not end by itself within `cleanup_timeout` and had to be sent TERM, and
    may raise). Raises FileNotFoundError
    without a codex binary, TimeoutError when it does not answer, RuntimeError with the server's message
    (trimmed) on an error reply."""
    exe = cli_command("codex")
    if not exe:
        raise FileNotFoundError("codex")
    argv = [*exe, "app-server"]
    if wrap is not None:
        argv = list(wrap(argv))
    p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
    lines = None
    try:
        lines = _Lines(p.stdout)

        def send(o):
            p.stdin.write((json.dumps(o) + "\n").encode("utf-8"))
            p.stdin.flush()
        send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
              "params": {"clientInfo": {"name": client[0], "title": client[0], "version": client[1]}}})
        send({"jsonrpc": "2.0", "method": "initialized", "params": {}})
        send({"jsonrpc": "2.0", "id": 2, "method": method, "params": params or {}})
        end = _now() + timeout
        while True:
            line = lines.readline(end)
            if line is None:
                raise TimeoutError("codex app-server did not answer")
            if not line:
                raise TimeoutError("codex app-server ended without an answer")
            try:
                o = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(o, dict) and o.get("id") == 2:
                if "error" in o:
                    raise RuntimeError(str((o.get("error") or {}).get("message") or "app-server error")[:200])
                res = o.get("result")
                return res if isinstance(res, dict) else {}
    finally:
        if lines is not None:
            lines.discard()                                # the server's last writes never wait on a full queue
        try:
            _stop_server(p, wrap is not None, cleanup_timeout, on_exit)
        finally:
            if lines is not None:
                lines.close()


def codex_identity(tokens: dict) -> dict:
    """Labels from a Codex auth.json `tokens` block: e-mail, plan type and a short workspace id
    (the tail of the ChatGPT account id). Decoded locally, displayed, compared with what the user
    asked for; never sent anywhere."""
    claims = _jwt_claims(tokens.get("id_token") or "") if isinstance(tokens, dict) else {}
    auth = claims.get("https://api.openai.com/auth") if isinstance(claims.get("https://api.openai.com/auth"), dict) else {}

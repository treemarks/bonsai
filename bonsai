def update_note() -> str:
    """`new version: bonsai update` when GitHub has commits this checkout lacks. Checked at most once a day
    (`git fetch`, the same source `bonsai update` uses) and never applied here."""
    d, git, path = repo_dir(), shutil.which("git"), os.path.join(STATE, "update_check.json")
    if not d or not git or any(k in os.environ for k in GIT_REDIRECT_VARS):
        return ""
    seen = _read_json(path, {})
    if not isinstance(seen, dict) or not isinstance(seen.get("at"), (int, float)) or _now() - seen["at"] > 86400:
        g = lambda *a: subprocess.run([git, "-C", d, *a], capture_output=True, encoding="utf-8", errors="replace", timeout=20)
        try:
            n = g("fetch", "--quiet").returncode == 0 and g("rev-list", "--count", "HEAD..@{u}").stdout.strip()
            seen = {"at": _now(), "behind": int(n) if n and n.isdigit() else 0}
        except (OSError, subprocess.SubprocessError):
            seen = {"at": _now(), "behind": 0}
        _write_json(path, seen)
    return "new version: bonsai update" if seen.get("behind") else ""


LOCAL_MODELS = (("whisper", "whisper"), ("llama-server", "llama.cpp"), ("llama-cli", "llama.cpp"),
                ("mlx_lm", "mlx"), ("mlx_whisper", "whisper"), ("LM Studio", "LM Studio"))


def running_model() -> str:
    """What this machine is running, for the board: a Bonsai job, a model Ollama has loaded (its local API, no
    network), or a local model process (Whisper, llama.cpp, MLX, LM Studio) with its model file; `·` when none."""
    running = [j for j in read_jobs() if "exit" not in j and not j.get("lost")]
    if running:
        return "bonsai job: %s" % (running[-1].get("label") or running[-1].get("provider") or "?")
    try:
        class _Stay(urllib.request.HTTPRedirectHandler):
            def redirect_request(self, *a, **k):
                return None                                  # a redirect is refused, never followed
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _Stay)   # loopback only, never a proxy
        with opener.open("http://127.0.0.1:11434/api/ps", timeout=0.3) as r:
            body = json.loads(r.read(65536)) if r.geturl().startswith("http://127.0.0.1:11434/") else {}
            names = [x.get("name") for x in body.get("models", []) if isinstance(x, dict) and x.get("name")]
        if names:
            return names[0] + (" +%d" % (len(names) - 1) if len(names) > 1 else "")
    except Exception:
        pass
    try:
        args = subprocess.run(["ps", "-A", "-o", "args="], capture_output=True, text=True, timeout=5).stdout.splitlines()
    except Exception:
        return "·"
    for line in args:
        for needle, name in LOCAL_MODELS:
            if needle.lower() in line.lower() and "grep" not in line:
                m = re.search(r"(?:^|\s)(?:-m|--model)[ =](\S+)", line)
                return "%s %s" % (name, os.path.basename(m.group(1)).rsplit(".", 1)[0]) if m else name
    return "·"


WIDTH = 80          # a standard terminal; the fleet gauge's columns, with PLAN where it has FABLE
HUE = {"claude": "\033[38;5;208m", "codex": "\033[38;5;141m"}       # the fleet gauge's orange and purple
NAME = {"claude": "Anthropic", "codex": "OpenAI"}


def render(state: dict, cfg: dict, p: Paint, width: int, interval: int) -> str:
    """The board in the fleet gauge's shape. In colour the provider is the login's colour, named on the top row; without
    colour a VIA column says it. One row per login, soonest weekly reset first, a problem shown where the bar would be;
    a login never signed in (`default` with no login) is left out: not everyone has both providers."""
    rows = sorted([r for r in state.get("rows", []) if isinstance(r, dict)
                   and not (r.get("pool") == "default" and r.get("state") in ("no-login", "cli-missing")
                            and not r.get("last_good"))],      # never seen working: hidden; one that stopped stays
                  key=lambda r: (r.get("state") not in ("OK", "LIMITED", "signed-in"),
                                 r.get("wk_at") or (r.get("reading") or {}).get("wk_at") or float("inf")))
    hue = lambda prov, t: (HUE.get(prov, "") + t + "\033[0m") if p.on and prov in HUE else t
    age = _now() - (state.get("at") or _now())
    key = "".join("  " + p.bold(hue(k, NAME[k])) for k in NAME if p.on and any(r.get("provider") == k for r in rows))
    head, right = p.bold("ACCOUNTS") + key, p.dim("as of %s ago   refresh in %s" % (_age(age), _age(max(0, interval - age))))
    lines = [head + " " * max(1, WIDTH - _vis(head) - _vis(right)) + right]
    bw = 24 if p.on else 20                 # without colour, VIA (4 cells) comes out of the bar
    via = "" if p.on else "%-3s " % "VIA"
    lines.append(p.dim("  %-10s %-10s %s%s %-5s %-6s %-5s %-6s %s" % ("LOGIN", "PLAN", via, " " * bw, "%LEFT", "RESET", "5H", "RESET", "PROMO")))
    if not rows:
        lines.append("  " + p.dim("no logins set up: `bonsai login <email> --claude` or `--codex`"))
    for r in rows:
        q = r if r.get("state") in ("OK", "LIMITED") else (r.get("last_good") or {})
        if r.get("provider") == "claude":
            q = r.get("reading") or {}
        wk = (100.0 - q["wk"]) if isinstance(q.get("wk"), (int, float)) else None
        fh = (100.0 - q["5h"]) if isinstance(q.get("5h"), (int, float)) else None
        if r.get("state") in ("OK", "signed-in") and (wk is not None or r.get("provider") != "claude"):
            gauge = level_color(p, wk, bar(wk, bw))
        elif r.get("state") == "signed-in":                 # a Claude login with no reading yet: never shown as full
            gauge = _fixw(p.dim("unavailable"), bw)
        else:
            gauge = _fixw((p.red if r.get("state") == "LIMITED" else p.yellow)(display_text(str(r.get("state", "?")).lower(), bw)), bw)
        credits = r.get("reset_credits")
        promo = ("%dx" % credits) if isinstance(credits, int) and not isinstance(credits, bool) and credits > 0 else "·"
        prov = r.get("provider")
        lines.append("  %s %-10s %s%s %s %-6s %s %-6s %s" % (
            hue(prov, _fixw(display_text(r.get("name") or r.get("pool", "?"), 10), 10)),
            display_text(q.get("plan") or r.get("plan") or "·", 10),
            "" if p.on else "%-3s " % PROVIDER_LABEL.get(prov, display_text(prov, 3)), gauge,
            _fixw(level_color(p, wk, "%.0f%%" % wk) if wk is not None else "-", 5),
            _age(q["wk_at"] - _now()) if isinstance(q.get("wk_at"), (int, float)) else "—",
            _fixw(level_color(p, fh, "%.0f%%" % fh) if fh is not None else "-", 5),
            _age(q["5h_at"] - _now()) if isinstance(q.get("5h_at"), (int, float)) else "—", promo))
    lines.append("")
    m = machine_stats()
    lines.append(p.dim("  %-10s %-10s %-24s %-5s %-6s %-5s %-6s %s" % ("MACHINE", "MODEL", "CPU%", "GPU%", "MEM%", "SWAP", "HDD%", "BATT%")))
    batt = "·"
    if m.get("batt") is not None:
        batt = "%d%%" % m["batt"]
        if m.get("ac") is False:
            batt = level_color(p, float(m["batt"]), batt)
    pct = lambda k: ("%.0f%%" % m[k]) if m.get(k) is not None else "·"
    try:
        du = shutil.disk_usage(os.path.expanduser("~"))
        m["disk"] = 100.0 * du.used / du.total
    except OSError:
        pass
    lines.append("  %-10s %-10s %-24s %-5s %-6s %-5s %-6s %s" % (
        display_text(m.get("host", "?"), 10), display_text(running_model(), 10), pct("cpu"), pct("gpu"), pct("mem"),
        ("%.0fGB" % m["swap_gb"]) if m.get("swap_gb") is not None else "·", pct("disk"), batt))
    return "\n".join(lines)


def cmd_gauge(a, cfg) -> int:
    p = Paint(not a.no_color and sys.stdout.isatty())
    interval = max(180, int(a.interval or cfg.get("interval") or DEFAULT_INTERVAL))
    cfg = {**cfg, "interval": interval}
    def freshened(state):
        # Asked for the board: each Claude login whose reading is older than 15 minutes is read now (`/usage`, no model
        # turn); one with no reading shows as unknown, never as full.
        for r in state.get("rows", []):
            if r.get("provider") == "claude" and r.get("state") in ("signed-in", "OK", "LIMITED") and stale(r["pool"]):
                read_usage_now(r["pool"])
        return apply_readings(state)
    if a.once:
        state = freshened(refresh(cfg, force=a.fresh))
        if getattr(a, "json", False):
            emit(gauge_json(state, cfg, interval))
            return 0
        print(render(state, cfg, p, shutil.get_terminal_size((100, 30)).columns, interval))
        print(p.dim("\ngithub.com/treemarks/bonsai"))
        return 0
    try:
        force, note = a.fresh, ""
        while True:
            state = freshened(refresh(cfg, force=force))
            force = False
            sys.stdout.write("\033[H\033[2J" if p.on else "\n")
            print(render(state, cfg, p, shutil.get_terminal_size((100, 30)).columns, interval))
            lead = ("\033[38;5;221m%s\033[0m" % note if p.on else note) if note else p.dim("github.com/treemarks/bonsai")
            print("\n" + lead + p.dim(" · Ctrl-C to quit"))       # an update notice takes the link's place
            sys.stdout.flush()
            if p.on and sys.stdout.isatty():      # a person watching, never a script: checked daily, after a frame
                note = update_note()
            time.sleep(5)
    except KeyboardInterrupt:
        print()
        return 0



def display_text(value, width: int | None = None) -> str:
    """Data for the terminal: anything not printable (escape sequences, newlines) is shown as an escape, so a
    label cannot spoof a row or drive the terminal. Bonsai's choice: the escape stays visible."""
    s = "".join(c if c.isprintable() else "\\u%04x" % ord(c) for c in str(value))
    return s[:width] if width else s



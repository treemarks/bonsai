def _job_lock_name(jid: str) -> str | None:
    return ("job-%s.lock" % jid) if isinstance(jid, str) and re.fullmatch(r"[0-9a-f]{32}", jid) else None


def job_lock_held(jid) -> bool:
    """Is the Bonsai process that started this job still running? It holds the job's lock for the
    whole run; the kernel releases it when the process ends, so a reused PID proves nothing."""
    name = _job_lock_name(jid)
    if not name:
        return False
    path = os.path.join(STATE, name)
    try:
        flags = os.O_RDWR | (os.O_NOFOLLOW if hasattr(os, "O_NOFOLLOW") else 0)
        fd = os.open(path, flags)
    except OSError:
        return False
    try:
        if IS_WIN:
            import msvcrt
            try:
                msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
                return False
            except OSError:
                return True
        import fcntl
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except (BlockingIOError, OSError):
            return True
    finally:
        os.close(fd)


@contextlib.contextmanager
def job_lock(jid: str):
    name = _job_lock_name(jid)
    if not name:
        yield
        return
    with state_lock(os.path.join(STATE, name)):
        yield


def read_jobs(limit: int | None = 200) -> list[dict]:
    """Every job, paired start-to-finish, ordered by each job's most recent event; the last `limit` of them, or all
    with None (what counts running jobs reads them all: an old job may still be running)."""
    if limit is not None and limit <= 0:
        return []
    by_id: dict = {}
    try:
        with open(jobs_path(), encoding="utf-8") as f:
            for ln in f:
                try:
                    e = json.loads(ln)
                except ValueError:
                    continue
                if not isinstance(e, dict) or not isinstance(e.get("id"), str):
                    continue
                j = by_id.pop(e["id"], {})
                j.update(e)
                by_id[e["id"]] = j
    except FileNotFoundError:
        return []
    jobs = list(by_id.values())
    for j in jobs:
        if "exit" not in j:
            j["lost"] = not job_lock_held(j.get("id"))
    return jobs if limit is None else jobs[-limit:]


DEFAULT_JOB_TIMEOUT_MINUTES = 20
STOP_GRACE_SECONDS = 10


def _stop_child(p) -> None:
    """Stop a job this process started, with all it started. POSIX: TERM its group, a grace, then KILL whatever of the
    group is left, leader gone or not. Windows: `taskkill /T /F` on the pid held here (never one from the ledger)."""
    if IS_WIN:
        subprocess.run(["taskkill", "/PID", str(p.pid), "/T", "/F"], capture_output=True)
        try:
            p.wait(10)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
        return

    def group_alive():
        try:
            os.killpg(p.pid, 0)
            return True
        except OSError:
            return False
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(p.pid, sig)
        except OSError:
            pass
        end = _now() + STOP_GRACE_SECONDS
        while _now() < end:
            if p.poll() is not None and not group_alive():    # the leader reaped, and no one left in its group
                return
            time.sleep(0.1)
    p.wait()


class Job:
    """A job from the moment it is asked for: `--timeout` and `bonsai cancel` hold over its preparation too."""

    def __init__(self, provider: str, label: str, timeout_minutes: float | None):
        self.id, self.provider, self.minutes = uuid.uuid4().hex, provider, timeout_minutes
        self.t0 = _now()
        self.deadline = (self.t0 + timeout_minutes * 60) if timeout_minutes else None
        self.code, self.outcome = 1, None

    def path(self, ext: str) -> str:
        return os.path.join(STATE, "job-%s.%s" % (self.id, ext))

    def left(self) -> float | None:
        return None if self.deadline is None else max(0.0, self.deadline - _now())

    def stopped(self) -> str | None:
        if self.deadline is not None and _now() >= self.deadline:
            return "timeout"
        return "cancelled" if cancel_requested(self.id) else None

    def within(self, fn, *args):
        """A preparation step (probes, the locks they wait on, a usage read) run aside, inside the limit and the cancel.
        Each process it starts gets a group of its own; on a stop they are stopped and reaped before the job ends."""
        box, started, real, lock = {}, [], subprocess.Popen, threading.Lock()

        def popen(*a, **kw):
            if threading.current_thread() is not t:    # only this step's thread is held to its stop
                return real(*a, **kw)
            with lock:                             # a process is either started and listed, or refused: never neither
                if box.get("stop"):
                    raise OSError("the job is stopping")
                started.append(real(*a, **dict(kw, **({"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP} if IS_WIN else {"start_new_session": True}))))
                return started[-1]

        def run():
            try:
                box["v"] = fn(*args)
            except BaseException as e:             # handed back to the job's thread as it was
                box["e"] = e
        t = threading.Thread(target=run, daemon=True)
        subprocess.Popen = popen
        try:
            t.start()
            while t.is_alive():
                t.join(0.5)
                if self.stopped():
                    with lock:
                        box["stop"] = True
                    for p in list(started):
                        if not IS_WIN or p.poll() is None:
                            _stop_child(p)
                    self.check()
        finally:
            if not t.is_alive():                   # a stopped step's thread may still run: the refusing launcher stays
                subprocess.Popen = real
        if "e" in box:
            raise box["e"]
        return box["v"]

    def check(self) -> None:
        """Between preparation steps: a job past its limit or cancelled stops here, before anything is sent."""
        self.outcome = self.stopped()
        if self.outcome:
            self.code = {"timeout": 124, "cancelled": 130}[self.outcome]
            raise SystemExit("bonsai: job %s %s before it started; nothing was sent or published" % (
                self.id[:8], "ran past its limit" if self.outcome == "timeout" else "was cancelled"))


@contextlib.contextmanager
def start_job(provider: str, label: str, timeout_minutes: float | None):
    j = Job(provider, label, timeout_minutes)
    with job_lock(j.id):
        record_job({"id": j.id, "at": _iso(j.t0), "provider": provider, "label": label, "pid": os.getpid()})
        print("bonsai: job %s started%s; `bonsai jobs` shows it, `bonsai cancel %s` stops it" % (
            j.id[:8], (" (stops itself after %g min)" % timeout_minutes) if timeout_minutes else "", j.id[:8]),
            file=sys.stderr)
        sys.stderr.flush()
        try:
            yield j
        finally:
            record_job({"id": j.id, "exit": j.code, "outcome": j.outcome or "failed", "finished_at": _iso(_now()),
                        "seconds": round(_now() - j.t0, 1)})


def _private_file(path: str):
    return os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600),
                     "w", encoding="utf-8")


def _text_of(path) -> str:
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except (OSError, TypeError):
        return ""


def run_job(argv: list[str], provider: str, pool: str, label: str, stdin_text: str | None = None,
            cwd: str | None = None, capture_to: str | None = None, env: dict | None = None,
            timeout_minutes: float | None = None, after=None, job: Job | None = None, web: bool = False) -> int:
    """Run the job and record its process and outcome (ok, failed, timeout, cancelled). The launch guard runs first.
    The job has its own process group; its prompt comes from a private file, its output and messages go to private
    files (the messages can quote the prompt). `after(outcome, output, messages)` makes the answer (default: the
    output); only an ok job's answer is published, to `capture_to` (atomically, with a newline) or this terminal."""
    require(provider, argv, cwd, web)
    if job is None:
        with start_job(provider, label, timeout_minutes) as j:
            return run_job(argv, provider, pool, label, stdin_text, cwd, capture_to, env, after=after, job=j, web=web)
    j = job
    j.check()                                      # the last word before anything is sent
    record_job({"id": j.id, "pool": pool, "cmd": _tool_name(argv[1] if len(argv) > 1 and _tool_name(argv[0]) == "node" else argv[0]) if argv else ""})
    outpath, errpath, files, outcome = j.path("out"), j.path("err"), [], None
    try:
        fin = tempfile.TemporaryFile(dir=STATE)
        files.append(fin)
        fin.write((stdin_text or "").encode("utf-8"))
        fin.seek(0)
        files += [_private_file(outpath), _private_file(errpath)]
        kw = {"env": env or child_env(provider, pool), "cwd": cwd, "stdin": fin, "stdout": files[1], "stderr": files[2]}
        if IS_WIN:
            kw["creationflags"] = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
        else:
            kw["start_new_session"] = True
        if not os.path.isabs(str(argv[0])):
            raise FileNotFoundError(argv[0])               # not installed, or a launcher Bonsai does not start
        p = subprocess.Popen(argv, **kw)
        record_job({"id": j.id, "child": p.pid})
        try:
            # Waits in short slices, so a `bonsai cancel` recorded in the ledger is seen while the job runs (on Windows
            # that is the only way: the process that started the job is the one that stops it).
            while True:
                left = j.left()
                try:
                    p.wait(1.0 if left is None else max(0.01, min(1.0, left)))
                    break
                except subprocess.TimeoutExpired:
                    outcome = j.stopped()
                    if outcome:
                        _stop_child(p)
                        break
        except KeyboardInterrupt:
            _stop_child(p)
            outcome = "cancelled"
        if not IS_WIN:
            _stop_child(p)                         # nothing the job started outlives it
        for f in files:
            f.close()
        code = p.returncode
        outcome = outcome or j.stopped() or ("ok" if code == 0 else "cancelled" if code < 0 else "failed")
        output = _text_of(outpath)
        answer = after(outcome, output, _text_of(errpath)) if after else output
        answer = output if answer is None else answer
        if outcome == "ok":
            outcome = j.stopped() or "ok"          # a stop that landed as the job finished beats its exit 0
        code = {"timeout": 124, "cancelled": 130}.get(outcome, code)
        if outcome == "ok":
            answer += "\n" if answer and not answer.endswith("\n") else ""     # zsh shows `ok%` otherwise
            if capture_to:
                fd, tmp = tempfile.mkstemp(prefix=".bonsai-out-", dir=os.path.dirname(os.path.abspath(capture_to)) or ".")
                try:
                    with os.fdopen(fd, "w", encoding="utf-8") as f:
                        f.write(answer)
                    replace(tmp, os.path.abspath(capture_to))
                finally:
                    if os.path.exists(tmp):
                        os.unlink(tmp)
            else:
                sys.stdout.write(re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]", "", answer) if sys.stdout.isatty() else answer)
        elif outcome == "timeout":
            print("bonsai: job %s ran past its %g-minute limit and was stopped; nothing was published. Give it longer "
                  "with --timeout MINUTES, or `bonsai config --set job_timeout=MINUTES` (0: no limit)."
                  % (j.id[:8], j.minutes or 0), file=sys.stderr)
        elif outcome == "cancelled":
            print("bonsai: job %s was cancelled; nothing was published" % j.id[:8], file=sys.stderr)
        else:
            print("bonsai: the job failed (exit %d)%s" % (code, "; the previous output file was left alone" if capture_to
                                                          else ""), file=sys.stderr)
        if outcome != "ok" and os.path.getsize(errpath):
            print("bonsai: the tool's own messages are in %s (private: they can quote your prompt, so they are not "
                  "shown here)" % errpath, file=sys.stderr)
    except FileNotFoundError:
        print("bonsai: %s is not installed (or not on PATH)" % _tool_name(argv[0] if argv else "?"), file=sys.stderr)
        code, outcome = 127, "failed"
    except OSError:
        print("bonsai: could not start the job or publish its output", file=sys.stderr)
        code, outcome = 126, "failed"
    finally:
        for f in files:
            if not f.closed:
                f.close()
        for path in (outpath, j.path("answer")) + ((errpath,) if outcome == "ok" else ()):
            if os.path.exists(path):
                os.unlink(path)
    j.code, j.outcome = code, outcome
    return code


def cancel_requested(jid: str) -> bool:
    return any(j.get("id") == jid and j.get("cancel") for j in read_jobs(None))


def cancel_job(prefix: str) -> int:
    """Stop one running job of this machine by its id (4 or more of its characters), with everything it started. The
    request goes in the ledger; the process running the job sees it within a second, stops its whole process group, and
    publishes nothing. No signal is sent to a pid read back from the ledger."""
    p = str(prefix or "").strip().lower()
    if not re.fullmatch(r"[0-9a-f]{4,32}", p):
        raise SystemExit("bonsai cancel: give a job id from `bonsai jobs` (at least 4 of its characters)")
    running = [j for j in read_jobs(None) if "exit" not in j and not j.get("lost") and j.get("id", "").startswith(p)]
    if not running:
        raise SystemExit("bonsai cancel: no running job %s here (`bonsai jobs` lists them)" % p)
    if len(running) > 1:
        raise SystemExit("bonsai cancel: %s matches %d running jobs; give more of the id" % (p, len(running)))
    j = running[0]
    record_job({"id": j["id"], "cancel": _iso(_now())})
    for _ in range(60):
        done = [x for x in read_jobs(None) if x.get("id") == j["id"] and "exit" in x]
        if done:
            print("bonsai: job %s %s" % (j["id"][:8], done[0].get("outcome") or "stopped"))
            return 0
        time.sleep(0.5)
    print("bonsai: asked job %s to stop; it has not finished yet (`bonsai jobs`)" % j["id"][:8])
    return 0


def _tool_name(path: str) -> str:
    base = os.path.basename(str(path)).lower()
    for ext in (".exe", ".cmd", ".bat", ".js"):
        if base.endswith(ext):
            base = base[: -len(ext)]
    return base



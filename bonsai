def cmd_login(a, cfg) -> int:
    provider = "claude" if a.claude else "codex"
    tool = shutil.which(provider)
    if not tool:
        raise SystemExit("bonsai: %s is not installed. %s" % (provider, INSTALL[provider]["windows" if IS_WIN else "darwin"]))
    # The pool is the e-mail unless --pool names another directory: one account can hold two
    # workspaces (ChatGPT shows "Select a workspace"), and each sign-in binds to one of them.
    pool = check_pool_name(getattr(a, "pool", None) or a.email)
    if pool == "default":
        raise SystemExit("bonsai: `default` is the CLI's own sign-in; run `%s` itself to sign that in" % provider)
    name = a.name or login_name(cfg, pool)
    if a.name:
        check_pool_name(a.name)  # a label obeys the same rules as a pool name (no routing words)

    def taken(label):
        return [other for other, entry in (cfg.get("logins") or {}).items() if other != pool and
                (other.casefold() == label.casefold() or (entry.get("name") or "").casefold() == label.casefold())]
    if taken(name):
        if a.name:
            raise SystemExit("bonsai: the label %r already names the pool %s; give this sign-in its own --name"
                             % (name, taken(name)[0]))
        name = pool  # two logins at one domain: the second is labelled by its full address, never ambiguous
    d = pool_dir(provider, pool)
    private_dir(d)
    acknowledged = bool(cfg.get("acknowledged"))  # once per machine, not per login
    if a.institution and not acknowledged:
        print(INSTITUTION_NOTICE % {"name": name})
        if not getattr(a, "acknowledge", False) and sys.stdin.isatty():
            if input("Type  I understand  to continue: ").strip().lower() != "i understand":
                raise SystemExit("bonsai: not acknowledged; nothing changed")
    argv = [tool, "auth", "login", "--email", a.email] if provider == "claude" else [tool, "login"]
    if provider == "claude" and getattr(a, "sso", False):
        argv.append("--sso")
    if provider == "codex" and getattr(a, "device_auth", False):
        argv.append("--device-auth")
    print("bonsai: signing %s in as %s pool %s (a browser window opens; check the e-mail and, for ChatGPT, "
          "the workspace the page shows before you approve)" % (provider, pool, d))
    sys.stdout.flush()
    rc = subprocess.call(argv, env=child_env(provider, pool))
    if rc != 0:
        print("bonsai: sign-in did not complete (exit %d). Bonsai did not record this login. The pool folder and any "
              "earlier sign-in in it may still exist; do not run jobs on this pool until `bonsai doctor` shows the "
              "account you meant. Run the same line again when ready." % rc, file=sys.stderr)
        return rc
    found = login_identity(provider, pool, d)
    if found.get("email") and found["email"].casefold() != a.email.casefold():
        print("bonsai: the %s sign-in that completed is %s, not %s. Nothing was recorded. The browser signed in "
              "another account (one it was already signed in to, perhaps). Sign that pool out and try again in a "
              "private window:\n  %s" % (provider, found["email"], a.email, logout_line(provider, pool)), file=sys.stderr)
        return 1
    entry = cfg.setdefault("logins", {}).setdefault(pool, {})
    entry["name"] = name
    entry.setdefault("institutions", {})[provider] = bool(a.institution)
    if a.institution and not acknowledged:
        now = _iso(_now())
        cfg["acknowledged"] = {"at": now, "pool": pool}
        # Acknowledged is shown: the first job and install-skill do not print the notice again.
        cfg["notice_shown"] = {"version": NOTICE_VERSION, "how": "login", "at": now}
    save_config(cfg)
    try:
        os.remove(cache_path())  # the board re-probes: a row for this pool must not stay stale for an interval
    except OSError:
        pass
    print("bonsai: %s pool %s recorded as %s%s" % (provider, pool, name, " (marked institution by you)" if a.institution else ""))
    print("bonsai: signed in as %s" % describe_identity(found))
    if a.institution:
        if provider == "codex":
            print("bonsai: the workspace is shown as a plan type and a short id (two pools with one id are the same "
                  "workspace). Confirm it is the workspace you chose in the browser; Bonsai cannot name it. Your "
                  "university e-mail and the ⌂ mark do not prove the workspace, and neither proves approval for any data.")
        else:
            print("bonsai: check the organization shown is your university's. The e-mail and the ⌂ mark do not prove "
                  "it, and neither proves approval for any data.")
    return 0


def login_identity(provider: str, pool: str, d: str) -> dict:
    """What the CLI says is signed in to this pool, as labels: e-mail, org/plan, workspace id."""
    if provider == "claude":
        st = claude_status(pool) or {}
        if not st.get("loggedIn"):
            return {}
        return {"email": st.get("email"), "org": st.get("orgName"), "plan": st.get("subscriptionType")}
    auth = _read_json(os.path.join(d, "auth.json"), None)
    t = auth.get("tokens", auth) if isinstance(auth, dict) else None
    return codex_identity(t) if isinstance(t, dict) else {}


def describe_identity(found: dict) -> str:
    parts = [display_text(found.get("email") or "?", 60)]
    if found.get("org"):
        parts.append("org %s" % display_text(found["org"], 40))
    if found.get("plan"):
        parts.append("plan %s" % display_text(found["plan"], 16))
    if found.get("workspace"):
        parts.append("workspace id %s" % display_text(found["workspace"], 8))
    return " · ".join(parts)


def logout_line(provider: str, pool: str) -> str:
    """The exact sign-out command for one pool, with the pool directory spelled out (no routing)."""
    d = pool_dir(provider, pool)
    if provider == "claude":
        return "CLAUDE_CONFIG_DIR=%s claude auth logout" % shlex.quote(d) if pool != "default" else "claude auth logout"
    return "CODEX_HOME=%s codex logout" % shlex.quote(d) if pool != "default" else "codex logout"


def cmd_route(a, cfg) -> int:

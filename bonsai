def _data_gate(data: str | None, kind: str, chat: bool, provider: str | None) -> str:
    """Apply a --data declaration before anything is read or probed. `low` or no declaration:
    route as asked. `moderate`, `high`, `phi`: refused wherever the command runs from (a Terminal
    is not a sign of approval any more than a chat is). `restricted`: refused everywhere."""
    if data in (None, "low"):
        return kind
    if data == "restricted":
        raise SystemExit("bonsai: refused: payment-card data, CUI and export-controlled material are approved for no AI tool.")
    note = ("\n" + PHI_NOTE.get(provider or "", "")) if data == "phi" else ""
    raise SystemExit(PRIVATE_HANDOFF % (data, note))


def ensure_notice(cfg: dict, how: str) -> None:
    """Print the notice once per version on this machine, before the first job or at install-skill,
    unless `bonsai login --institution` already had it acknowledged, and record how it was shown.
    It reaches whoever is at the terminal, which may be an agent; the skill tells the agent to
    relay it, and the docs tell the human to expect it."""
    shown = cfg.get("notice_shown") or {}
    if shown.get("version") == NOTICE_VERSION:
        return
    print(INSTITUTION_NOTICE % {"name": "institution"}, file=sys.stderr)
    cfg["notice_shown"] = {"version": NOTICE_VERSION, "how": how, "at": _iso(_now())}
    try:
        save_config(cfg)
    except SystemExit:
        pass


def cmd_run(a, cfg) -> int:
    cmdv = list(a.cmd or [])
    if cmdv and cmdv[0] == "--":
        cmdv = cmdv[1:]
    if not cmdv:
        raise SystemExit("bonsai run: give the command after --")
    direct = {"claude": "claude", "codex": "codex"}.get(_tool_name(cmdv[0]))
    if direct and a.provider and direct != a.provider:
        raise SystemExit("bonsai run: --provider %s conflicts with the command (%s)" % (a.provider, direct))
    provider = a.provider or direct
    if provider is None:
        raise SystemExit("bonsai run: a wrapper needs an explicit --provider claude|codex")
    kind = _data_gate(getattr(a, "data", None), a.kind, chat_driven(), provider)
    ensure_notice(cfg, "run")
    state = refresh(cfg)
    row = pick(state, provider, kind, a.pool, cfg)
    print("bonsai: %s on %s (%s): %s" % (provider, display_text(row.get("name") or row["pool"], 24),
                                        display_text(row["pool"], 40), row.get("why") or "named"), file=sys.stderr)
    if row.get("institution") and chat_driven():
        print(CHAT_DRIVEN_REMINDER % display_text(row.get("name") or row["pool"], 24), file=sys.stderr)
    if getattr(a, "dry_run", False):
        print(" ".join(cmdv))
        return 0
    return run_job(cmdv, provider, row["pool"], label=_tool_name(cmdv[0]))


def resolve_target(target: str, cfg: dict, model: str | None) -> tuple[str, str | None, str | None]:
    """(provider, login wanted, model id) from a target word: `claude` / `codex` (auto login),
    `<name>-claude` / `<name>-codex`, a model alias (`astra`: auto login for its provider), or
    `<alias>@<name>`."""
    models = cfg.get("models") or {}
    t = target.lower()
    if "@" in t and t.split("@")[0] in models:
        alias, want = t.split("@", 1)
        prov, mid = models[alias]
        return prov, want, model or mid
    if t in models:
        prov, mid = models[t]
        return prov, None, model or mid
    # The provider words people use: the company, the product and the CLI name all mean the same seat.
    if t in PROVIDER_WORDS:
        return PROVIDER_WORDS[t], None, model
    for word, prov in PROVIDER_WORDS.items():
        if t.endswith("-" + word) and len(t) > len(word) + 1:
            return prov, t[: -len(word) - 1], model
    raise SystemExit("bonsai: unknown target %r. Try claude, codex, stanford-claude, stanford-codex "
                     "(also stanford-openai, stanford-chatgpt, stanford-anthropic), personal-codex, "
                     "or a model alias (%s)" % (target, ", ".join(sorted(models))))


PROVIDER_WORDS = {"claude": "claude", "anthropic": "claude",
                  "codex": "codex", "openai": "codex", "chatgpt": "codex", "gpt": "codex"}


# ── small helpers ────────────────────────────────────────────────────────────────

def _now() -> float:
    return time.time()


def _iso(ts: float) -> str:
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _when_ts(v) -> float | None:
    """A provider timestamp (epoch seconds, epoch milliseconds or ISO-8601) as epoch seconds,
    or None when it is not finite or not between 2000 and 2100."""
    if v is None or isinstance(v, bool):
        return None
    x = None
    if isinstance(v, (int, float)):
        x = float(v)
        if not math.isfinite(x):
            return None
        if x > 1e11:
            x = x / 1000.0
    elif isinstance(v, str):
        s = v.strip()
        if re.fullmatch(r"\d+(\.\d+)?", s):
            return _when_ts(float(s))
        try:
            if s.endswith("Z"):
                s = s[:-1] + "+00:00"
            x = dt.datetime.fromisoformat(s).timestamp()
        except ValueError:
            return None
    if x is None or not (946684800 <= x <= 4102444800):
        return None
    return x


def _age(seconds: float | None) -> str:
    """Whole minutes at least, never seconds."""
    if seconds is None or (isinstance(seconds, float) and not math.isfinite(seconds)):
        return "·"
    s = max(0, int(seconds))
    if s < 60:
        return "<1m"
    m = s // 60
    if m < 60:
        return "%dm" % m
    h = m // 60
    if h < 24:
        return "%dh%02dm" % (h, m % 60)
    d = h // 24
    return "%dd%dh" % (d, h % 24)


def _pct(v) -> float | None:
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
        return None
    return max(0.0, min(100.0, float(v)))


def _jwt_claims(tok: str) -> dict:
    """A JWT's claims, decoded locally for labels only (no signature check, no authz)."""
    try:
        payload = tok.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
        return claims if isinstance(claims, dict) else {}
    except Exception:
        return {}


def display_text(value, width: int | None = None) -> str:
    """Data for the terminal: anything not printable (escape sequences, newlines) is shown as
    an escape, so a label cannot spoof a row or drive the terminal."""
    s = "".join(c if c.isprintable() else "\\u%04x" % ord(c) for c in str(value))
    return s[:width] if width else s


def _read_json(path: str, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def private_dir(path: str) -> None:
    """A directory only this user can enter. Only for Bonsai's own state, config and pools."""
    if os.path.islink(path):
        raise SystemExit("bonsai: %s is a symlink; Bonsai's private directories must be real" % path)
    os.makedirs(path, mode=0o700, exist_ok=True)
    if not IS_WIN:
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass


def atomic_text(path: str, text: str) -> None:
    """Write a file in one step: a private temp file beside it, then a rename. Never truncates
    the target on the way, never follows a planted symlink."""
    path = os.path.abspath(path)
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".bonsai-", dir=parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if not IS_WIN:
            os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def _write_json(path: str, obj) -> None:
    private_dir(os.path.dirname(os.path.abspath(path)))
    atomic_text(path, json.dumps(obj, indent=1, sort_keys=True, allow_nan=False))


def _append_private(path: str, line: str) -> None:
    """One line onto a 0600 file that is never a symlink, under a lock around the whole write."""
    private_dir(os.path.dirname(os.path.abspath(path)))
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    with state_lock(os.path.basename(path) + ".lock"):
        fd = os.open(path, flags, 0o600)
        try:
            if not IS_WIN:
                os.fchmod(fd, 0o600)
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)


@contextlib.contextmanager
def state_lock(name: str):
    """An exclusive inter-process lock on a private file under STATE."""
    private_dir(STATE)
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(os.path.join(STATE, name), flags, 0o600)
    try:
        if IS_WIN:
            import msvcrt
            os.lseek(fd, 0, 0)
            msvcrt.locking(fd, msvcrt.LK_LOCK, 1)
        else:
            import fcntl
            os.fchmod(fd, 0o600)
            fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            if IS_WIN:
                import msvcrt
                os.lseek(fd, 0, 0)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
        except Exception:
            pass
        os.close(fd)


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    saved = _read_json(CONFIG_PATH, {})
    if not isinstance(saved, dict):
        return cfg
    for k, v in saved.items():
        if isinstance(v, dict) and isinstance(cfg.get(k), dict):
            cfg[k].update(v)
        else:
            cfg[k] = v
    return cfg


def validate_config(cfg: dict) -> list[str]:
    """The names of the keys that are unknown or malformed (never their values)."""
    bad = []
    for k, v in cfg.items():
        check = CONFIG_SCHEMA.get(k)
        if check is None or not check(v):
            bad.append(k)
    return bad


def save_config(cfg: dict) -> None:
    bad = validate_config(cfg)
    if bad:
        raise SystemExit("bonsai: config has unknown or malformed keys: %s" % ", ".join(sorted(bad)))
    _write_json(CONFIG_PATH, cfg)


def cfg_flag(cfg: dict | None, section: str, key: str) -> bool:
    """A usage-read switch. Must be a JSON boolean; a string "false" is an error, not a yes."""
    cfg = cfg if cfg is not None else load_config()
    value = (cfg.get(section) or {}).get(key, DEFAULT_CONFIG[section][key])
    if not isinstance(value, bool):
        raise SystemExit("bonsai: %s.%s must be true or false (a JSON boolean)" % (section, key))
    return value


# ── pools: where each login lives ────────────────────────────────────────────────

def check_pool_name(pool: str) -> str:
    """A pool is one directory name: no separators, no path tricks, no control characters."""
    if (not isinstance(pool, str) or not pool or pool in (".", "..") or os.path.isabs(pool)
            or "/" in pool or "\\" in pool or pool.startswith(".")
            or any(ord(c) < 32 or ord(c) == 127 for c in pool)
            or (IS_WIN and any(c in pool for c in ':*?"<>|'))):
        raise SystemExit("bonsai: a pool is named by its e-mail address (one plain directory name)")
    if pool.casefold() in RESERVED_NAMES:
        raise SystemExit("bonsai: %r is a routing word, not a pool name; pick another --pool/--name" % pool)
    return pool


# Words the target grammar owns; a pool or label may not take them (`auto`, the provider words,
# the default model aliases), or `stanford-codex` and `--pool auto` would stop meaning what they say.
RESERVED_NAMES = frozenset({"auto", "claude", "anthropic", "codex", "openai", "chatgpt", "gpt",
                            "astra", "sol", "opus", "sonnet", "haiku", "default-claude", "default-codex"})


def pool_dir(provider: str, pool: str) -> str:
    if pool == "default":
        return os.path.join(POOLS_HOME, ".claude" if provider == "claude" else ".codex")
    check_pool_name(pool)
    root = ".claude-pools" if provider == "claude" else ".codex-pools"
    return os.path.join(POOLS_HOME, root, pool)


def keychain_service(cfg_dir: str, is_default: bool) -> str:
    """Claude Code keeps each config dir's OAuth blob in the login Keychain under
    `Claude Code-credentials` (for ~/.claude) or `Claude Code-credentials-<sha256(dir)[:8]>`.
    The dir string is the exact absolute path Bonsai passes as CLAUDE_CONFIG_DIR."""
    if is_default:
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(cfg_dir.encode()).hexdigest()[:8]


def _blob_state(d) -> tuple[dict | None, str]:
    if not isinstance(d, dict):
        return None, "bad-credfile"
    o = d.get("claudeAiOauth")
    if not isinstance(o, dict):
        return None, "bad-credfile"
    if not isinstance(o.get("accessToken"), str) or not o["accessToken"]:
        return None, "no-login"
    return d, "ok"


def claude_blob(cfg_dir: str, is_default: bool) -> tuple[dict | None, str]:
    """(credential blob, state). state: ok | no-login | locked | keychain-timeout | bad-credfile.
    Only called when the user turned Claude usage reads on. Claude Code keeps the OAuth blob in
    `.credentials.json` inside the config dir on Windows and Linux, and in the login Keychain on
    macOS; a blob with an empty access token is a signed-out stub."""
    cred = os.path.join(cfg_dir, ".credentials.json")
    if os.path.isfile(cred) and os.path.getsize(cred) > 0:
        return _blob_state(_read_json(cred, None))
    if not IS_MAC:
        return None, "no-login"
    svc = keychain_service(cfg_dir, is_default)
    try:
        # The first read of an item another program created makes macOS ask the user to allow
        # it; a person needs time to read the dialog and type a password.
        out = subprocess.run(["security", "find-generic-password", "-s", svc, "-w"],
                             capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return None, "keychain-timeout"
    except Exception:
        return None, "no-login"
    if out.returncode == 0 and out.stdout.strip():
        try:
            return _blob_state(json.loads(out.stdout))
        except Exception:
            return None, "bad-credfile"
    if out.returncode == 36:
        return None, "locked"       # no interaction possible here (ssh), or the keychain is locked
    try:
        meta = subprocess.run(["security", "find-generic-password", "-s", svc],
                              capture_output=True, text=True, timeout=10)
        if meta.returncode == 0:
            return None, "locked"   # the item exists; its secret is not readable in this shell
    except Exception:
        pass
    return None, "no-login"


def discover_pools() -> list[tuple[str, str, str]]:
    """Every (provider, pool, dir) that looks set up on this machine. A symlinked pool directory
    is skipped: it would alias another login."""
    out = []
    for provider in ("claude", "codex"):
        d = pool_dir(provider, "default")
        if os.path.isdir(d):
            out.append((provider, "default", d))
        root = os.path.dirname(pool_dir(provider, "x"))
        if os.path.isdir(root):
            for name in sorted(os.listdir(root)):
                p = os.path.join(root, name)
                if os.path.isdir(p) and not os.path.islink(p) and not name.startswith("."):
                    try:
                        check_pool_name(name)
                    except SystemExit:
                        continue
                    out.append((provider, name, p))
    return out


def login_name(cfg: dict, pool: str) -> str:
    entry = (cfg.get("logins") or {}).get(pool) or {}
    if isinstance(entry.get("name"), str) and entry["name"]:
        return entry["name"]
    if pool == "default":
        return "personal"
    local, _, domain = pool.partition("@")
    if domain and domain.lower().endswith("stanford.edu"):
        return "stanford"
    if domain:
        return domain.split(".")[0]
    return pool


def is_institution(cfg: dict, pool: str, provider: str) -> bool:
    entry = (cfg.get("logins") or {}).get(pool) or {}
    return (entry.get("institutions") or {}).get(provider) is True


def phi_approved(cfg: dict, pool: str, provider: str) -> bool:
    entry = (cfg.get("logins") or {}).get(pool) or {}
    return (entry.get("phi_approved") or {}).get(provider) is True


# ── the probe: one login's identity and room ─────────────────────────────────────

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None     # the three URLs Bonsai knows are final; a redirect never carries the token


def _get(url: str, headers: dict) -> dict:
    req = urllib.request.Request(url, headers=headers)
    opener = urllib.request.build_opener(_NoRedirect())
    with opener.open(req, timeout=TIMEOUT) as r:
        return json.loads(r.read())


def retry_deadline(headers) -> float:
    """When to try a login again after a 429: the Retry-After header if it is a sane number or
    date, else 15 minutes; never under 3 minutes, never over a day, never a value we echo."""
    raw = None
    try:
        raw = (headers or {}).get("Retry-After")
    except Exception:
        raw = None
    delay = 900.0
    if raw:
        try:
            delay = float(raw)
        except (TypeError, ValueError, OverflowError):
            try:
                delay = email.utils.parsedate_to_datetime(str(raw)).timestamp() - _now()
            except Exception:
                delay = 900.0
    if not math.isfinite(delay):
        delay = 900.0
    return _now() + min(86400.0, max(180.0, delay))


def _claude_headers(token: str) -> dict:
    """Bonsai says who it is and never presents itself as Claude Code."""
    return {"Authorization": "Bearer " + token, "anthropic-beta": "oauth-2025-04-20",
            "Accept": "application/json", "User-Agent": USER_AGENT}


def parse_claude_usage(d: dict) -> dict:
    """The fields the board needs from GET /api/oauth/usage: 5h and weekly utilization (0-100,
    percent used) with their resets, and any per-model weekly caps."""
    row: dict = {}
    for key, out in (("five_hour", "5h"), ("seven_day", "wk")):
        w = d.get(key)
        if isinstance(w, dict):
            row[out] = _pct(w.get("utilization"))
            row[out + "_at"] = _when_ts(w.get("resets_at"))
            if row[out] is None:
                row["incomplete_usage"] = True
    caps = {}
    for lim in d.get("limits") or []:
        if not isinstance(lim, dict) or lim.get("kind") != "weekly_scoped":
            continue
        name = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
        if name:
            caps[str(name).lower()] = {"used": _pct(lim.get("utilization")),
                                      "at": _when_ts(lim.get("resets_at") or lim.get("reset_at"))}
    if caps:
        row["model_caps"] = caps
    return row


def parse_codex_usage(d: dict) -> dict:
    """The fields the board needs from ChatGPT's `wham/usage` shape (kept for reference and
    tests; the probe itself asks Codex's app-server). A window without a sane duration is
    unknown and never overwrites a known one."""
    row: dict = {"plan": d.get("plan_type")}
    rl = d.get("rate_limit") or {}
    for w in (rl.get("primary_window"), rl.get("secondary_window")):
        if not isinstance(w, dict):
            continue
        secs = w.get("limit_window_seconds")
        if isinstance(secs, bool) or not isinstance(secs, (int, float)) or not math.isfinite(secs) or secs <= 0:
            row["incomplete_usage"] = True
            continue
        out = "5h" if secs <= 6 * 3600 else "wk"
        row[out] = _pct(w.get("used_percent"))
        row[out + "_at"] = _when_ts(w.get("reset_at"))
        if row[out] is None:
            row["incomplete_usage"] = True
    if rl.get("limit_reached"):
        row["limited"] = True
    return row


def parse_codex_rate_limits(res: dict) -> dict:
    """The fields the board needs from the app-server's `account/rateLimits/read` result."""
    row: dict = {}
    rl = res.get("rateLimits") or {}
    row["plan"] = rl.get("planType")
    for w in (rl.get("primary"), rl.get("secondary")):
        if not isinstance(w, dict):
            continue
        mins = w.get("windowDurationMins")
        if isinstance(mins, bool) or not isinstance(mins, (int, float)) or not math.isfinite(mins) or mins <= 0:
            row["incomplete_usage"] = True
            continue
        out = "5h" if mins <= 6 * 60 else "wk"
        row[out] = _pct(w.get("usedPercent"))
        row[out + "_at"] = _when_ts(w.get("resetsAt"))
        if row[out] is None:
            row["incomplete_usage"] = True
    if rl.get("rateLimitReachedType") or rl.get("spendControlReached"):
        row["limited"] = True
    return row


def claude_status(pool: str) -> dict | None:
    """Who this pool is signed in as, from Claude Code itself (`claude auth status --json`):
    email, organization, plan, loggedIn. No credential is read by Bonsai."""
    exe = shutil.which("claude")
    if not exe:
        return None
    try:
        out = subprocess.run([exe, "auth", "status", "--json"], capture_output=True, text=True,
                             timeout=60, env=child_env("claude", pool))
        d = json.loads(out.stdout or "{}")
        return d if isinstance(d, dict) else None
    except Exception:
        return None


def probe_claude(pool: str, cfg_dir: str, cfg: dict | None = None) -> dict:
    row = {"pool": pool, "provider": "claude", "state": "no-login"}
    reads = cfg_flag(cfg, "usage_reads", "claude")
    if not reads:
        st = claude_status(pool)
        if st is None:
            row["state"] = "cli-missing" if not shutil.which("claude") else "unknown"
            return row
        if not st.get("loggedIn"):
            return row
        row["account"] = st.get("email")
        row["org"] = st.get("orgName")
        row["plan"] = st.get("subscriptionType")
        row["state"] = "signed-in"
        return row
    blob, state = claude_blob(cfg_dir, pool == "default")
    if state != "ok":
        row["state"] = state
        return row
    tok = blob["claudeAiOauth"]["accessToken"]
    rexp = _when_ts(blob["claudeAiOauth"].get("refreshTokenExpiresAt"))
    if rexp:
        row["login_expires_at"] = rexp
    try:
        prof = _get("https://api.anthropic.com/api/oauth/profile", _claude_headers(tok))
        org = prof.get("organization") or {}
        row["account"] = (prof.get("account") or {}).get("email")
        row["plan"] = str(org.get("organization_type") or "").replace("claude_", "") or None
        row["org"] = org.get("name")
        if row["plan"] == "free":
            row["state"] = "no-plan"
            return row
        row.update(parse_claude_usage(_get("https://api.anthropic.com/api/oauth/usage", _claude_headers(tok))))
        row["state"] = "OK"
    except urllib.error.HTTPError as e:
        row["state"] = "re-login" if e.code == 401 else "http-%d" % e.code
        if e.code == 429:
            row["retry_after"] = retry_deadline(e.headers)
    except (urllib.error.URLError, TimeoutError, socket.timeout):
        row["state"] = "offline"
    except Exception as e:
        row["state"] = "error: " + type(e).__name__
    return row


def codex_app_server(pool: str, method: str, params: dict | None = None, timeout: float = 25.0):
    """One request to Codex's own app-server (`codex app-server`, JSON-RPC over stdio) under this
    pool's CODEX_HOME. Codex holds and refreshes the credential; Bonsai never sees it."""
    exe = shutil.which("codex")
    if not exe:
        raise FileNotFoundError("codex")
    p = subprocess.Popen([exe, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True, env=child_env("codex", pool))
    try:
        def send(o):
            p.stdin.write(json.dumps(o) + "\n")
            p.stdin.flush()
        send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
              "params": {"clientInfo": {"name": "bonsai", "title": "bonsai", "version": VERSION}}})
        send({"jsonrpc": "2.0", "method": "initialized", "params": {}})
        send({"jsonrpc": "2.0", "id": 2, "method": method, "params": params or {}})
        end = _now() + timeout
        while _now() < end:
            if IS_WIN:
                line = p.stdout.readline()
            else:
                import select
                r, _, _ = select.select([p.stdout], [], [], max(0.1, end - _now()))
                if not r:
                    continue
                line = p.stdout.readline()
            if not line:
                break
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if isinstance(o, dict) and o.get("id") == 2:
                if "error" in o:
                    raise RuntimeError(str((o.get("error") or {}).get("message") or "app-server error")[:200])
                res = o.get("result")
                return res if isinstance(res, dict) else {}
        raise TimeoutError("codex app-server did not answer")
    finally:
        try:
            p.kill()
        except Exception:
            pass


def codex_identity(tokens: dict) -> dict:
    """Labels from a Codex auth.json `tokens` block: e-mail, plan type and a short workspace id
    (the tail of the ChatGPT account id). Decoded locally, displayed, compared with what the user
    asked for; never sent anywhere."""
    claims = _jwt_claims(tokens.get("id_token") or "") if isinstance(tokens, dict) else {}
    auth = claims.get("https://api.openai.com/auth") if isinstance(claims.get("https://api.openai.com/auth"), dict) else {}
    acct = tokens.get("account_id") if isinstance(tokens, dict) else None
    acct = acct if isinstance(acct, str) and acct else (auth.get("chatgpt_account_id") if isinstance(auth.get("chatgpt_account_id"), str) else None)
    return {"email": claims.get("email") if isinstance(claims.get("email"), str) else None,
            "plan": auth.get("chatgpt_plan_type") if isinstance(auth.get("chatgpt_plan_type"), str) else None,
            "workspace": ("…" + acct[-4:]) if acct and len(acct) >= 4 else None}


def probe_codex(pool: str, cfg_dir: str, cfg: dict | None = None) -> dict:
    row = {"pool": pool, "provider": "codex", "state": "no-login"}
    try:
        auth_path = os.path.join(cfg_dir, "auth.json")
        if not (os.path.isfile(auth_path) and os.path.getsize(auth_path) > 0):
            return row
        auth = _read_json(auth_path, None)
        t = auth.get("tokens", auth) if isinstance(auth, dict) else None
        if not isinstance(t, dict) or not isinstance(t.get("access_token"), str) or not t["access_token"]:
            row["state"] = "bad-credfile"
            return row
        # Identity only, from the id token's claims (labels, never used for anything else): the
        # e-mail, the plan (`edu_pro`, `plus`, ...), and the last four characters of the ChatGPT
        # account id, which is the workspace: two pools signed into one workspace show one id.
        ident = codex_identity(t)
        row["account"] = ident.get("email")
        row["workspace"] = ident.get("workspace")
        if ident.get("plan"):
            row["plan"] = ident["plan"]
        if not cfg_flag(cfg, "usage_reads", "codex"):
            row["state"] = "signed-in"
            return row
        row.update(parse_codex_rate_limits(codex_app_server(pool, "account/rateLimits/read")))
        row["state"] = "LIMITED" if row.pop("limited", False) else "OK"
    except FileNotFoundError:
        row["state"] = "cli-missing"
    except TimeoutError:
        row["state"] = "unknown"
    except RuntimeError as e:
        msg = str(e).lower()
        row["state"] = "re-login" if ("auth" in msg or "login" in msg or "unauthorized" in msg) else "error"
    except SystemExit:
        raise
    except Exception as e:
        row["state"] = "error: " + type(e).__name__
    return row


def probe_all(cfg: dict, previous: dict | None = None) -> dict:
    """Every pool, once. A login under a 429 back-off keeps its last row until the back-off ends."""
    prev_rows = {(r.get("provider"), r.get("pool")): r for r in (previous or {}).get("rows", []) if isinstance(r, dict)}
    rows = []
    for provider, pool, d in discover_pools():
        old = prev_rows.get((provider, pool))
        until = old.get("retry_after") if old else None
        if isinstance(until, (int, float)) and math.isfinite(until) and _now() < until <= _now() + 86400:
            rows.append(dict(old))
            continue
        row = probe_claude(pool, d, cfg) if provider == "claude" else probe_codex(pool, d, cfg)
        if row["state"] not in ("OK", "LIMITED", "signed-in") and old and old.get("state") in ("OK", "LIMITED"):
            row["last_good"] = {k: old.get(k) for k in ("5h", "5h_at", "wk", "wk_at", "plan", "account")}
        rows.append(row)
    return annotate({"at": _now(), "rows": rows}, cfg)


def cache_path() -> str:
    return os.path.join(STATE, "last_probe.json")


def read_cache() -> dict | None:
    c = _read_json(cache_path(), None)
    return c if isinstance(c, dict) and isinstance(c.get("rows"), list) else None


def annotate(state: dict, cfg: dict) -> dict:
    """Lay the config's labels over the rows: the name and the per-provider institution flag are
    read from the config each time, so a `bonsai config --set` takes effect on the next render."""
    for r in state.get("rows", []):
        if isinstance(r, dict):
            r["name"] = login_name(cfg, r.get("pool", ""))
            r["institution"] = is_institution(cfg, r.get("pool", ""), r.get("provider", ""))
    return state


def refresh(cfg: dict, force: bool = False) -> dict:
    interval = max(180, int(cfg.get("interval") or DEFAULT_INTERVAL))

    def fresh(c):
        return c and not force and _now() - (c.get("at") or 0) < interval

    with state_lock("probe.lock"):
        cached = read_cache()
        if fresh(cached):
            return annotate(cached, cfg)
        state = probe_all(cfg, cached)
        _write_json(cache_path(), state)
        hist = []
        for r in state["rows"]:
            if r.get("state") in ("OK", "LIMITED"):
                hist.append(json.dumps({"at": _iso(state["at"]), "pool": r["pool"], "provider": r["provider"],
                                        "wk": r.get("wk"), "5h": r.get("5h")}))
        if hist:
            _append_private(os.path.join(STATE, "history.jsonl"), "\n".join(hist) + "\n")
        return state


# ── routing: which login a job starts on ─────────────────────────────────────────

def room(row: dict) -> tuple[float | None, str | None]:
    """(percent left, window) for the tighter of the two windows."""
    live = []
    for win in ("5h", "wk"):
        used = row.get(win)
        if isinstance(used, (int, float)) and not isinstance(used, bool) and math.isfinite(used):
            live.append((100.0 - used, win))
    return min(live) if live else (None, None)


def route(state: dict, provider: str, kind: str = "general") -> list[dict]:
    """The order for one provider: eligible logins, the room that expires soonest first.

    kind=general: personal logins only. kind=sensitive: institution seats only. Only a login the
    provider is serving (`OK`) with both windows read is eligible; `LIMITED` is a stop. Aggregate
    windows only: per-model caps are shown, not routed on."""
    out = []
    for r in state.get("rows", []):
        if r.get("provider") != provider or r.get("state") != "OK" or r.get("incomplete_usage"):
            continue
        if kind == "sensitive" and not r.get("institution"):
            continue
        if kind == "general" and r.get("institution"):
            continue
        left, win = room(r)
        if left is None:
            continue
        held = left < MIN_USABLE_PCT
        reset = r.get("wk_at")
        out.append({**r, "left": left, "window": win, "held": held,
                    "why": ("under %d%% in its %s window; waits" % (MIN_USABLE_PCT, win)) if held
                    else ("%.0f%% left in its %s window, weekly reset %s" % (
                        left, win, ("in " + _age(reset - _now())) if reset else "unknown"))})
    out.sort(key=lambda e: (e["held"], e.get("wk_at") if e.get("wk_at") is not None else float("inf"), -e["left"]))
    return out


def pick(state: dict, provider: str, kind: str, want: str | None, cfg: dict) -> dict:
    """Resolve `want` (None/auto, a login's label like `stanford`, its pool name, or its account
    e-mail; exact matches only) to a row."""
    rows = [r for r in state.get("rows", []) if r.get("provider") == provider]
    if want and want not in ("auto", ""):
        # Exact pool or name first; then the exact account e-mail. No prefixes: `stanford` must
        # not drift to `stanford-pro` because a second pool appeared (Astra, sign-in pass).
        w = want.casefold()
        hits = [r for r in rows if r.get("pool", "").casefold() == w or (r.get("name") or "").casefold() == w]
        if not hits:
            hits = [r for r in rows if (r.get("account") or "").casefold() == w]
        if not hits:
            raise SystemExit("bonsai: no %s login called %r is set up here; `bonsai doctor` lists them "
                             "(use the full pool name or label; prefixes are not matched)" % (provider, want))
        if len(hits) > 1:
            raise SystemExit("bonsai: %r matches several %s logins: %s" % (want, provider, ", ".join(sorted(r["pool"] for r in hits))))
        r = hits[0]
        if kind == "sensitive" and not r.get("institution"):
            raise SystemExit("bonsai: refused: sensitive work never runs on a personal login (%s)" % r["pool"])
        if r.get("state") == "LIMITED":
            raise SystemExit("bonsai: %s/%s is at its limit; a named login is not a way around a stop" % (provider, r["pool"]))
        if r.get("state") not in ("OK", "signed-in"):
            print("bonsai: note: %s/%s read %s on the last probe; trying it anyway" % (provider, r["pool"], r.get("state")), file=sys.stderr)
        return r
    order = route(state, provider, kind)
    if not order:
        signed = sorted([r for r in rows if r.get("state") == "signed-in"
                         and (bool(r.get("institution")) == (kind == "sensitive"))],
                        key=lambda r: (r.get("pool") != "default", r.get("pool", "")))
        if signed:
            # Signed in, no usage read (Claude, by default): nothing to rank on. The CLI's own
            # login first, then by name; the user can name one, or turn the usage read on.
            if len(signed) > 1:
                print("bonsai: note: %d %s logins are signed in and none has a usage read; using %s "
                      "(name one with --pool, or `bonsai config --set usage_reads.%s=true` to rank them)"
                      % (len(signed), provider, display_text(signed[0].get("name") or signed[0]["pool"], 24), provider),
                      file=sys.stderr)
            return signed[0]
        raise SystemExit("bonsai: no %s login is eligible for %s work right now (`bonsai route %s`)" % (provider, kind, provider))
    if order[0]["held"]:
        raise SystemExit("bonsai: every eligible %s login is under %d%% in its window; the soonest weekly reset is %s. "
                         "Wait, or name a login with --pool to spend what is left." % (
                             provider, MIN_USABLE_PCT,
                             ("in " + _age(order[0]["wk_at"] - _now())) if order[0].get("wk_at") else "unknown"))
    return order[0]


# What a job's process may see of this environment: the basics a CLI needs to run, nothing that
# names a login, a credential, a provider endpoint or a parent session. The pool's own config dir
# is added on top, so a job can only bill the login it was given.
KEEP_ENV = {"PATH", "HOME", "USER", "LOGNAME", "SHELL", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL",
            "LC_CTYPE", "TERM", "COLORTERM", "TZ", "SYSTEMROOT", "WINDIR", "COMSPEC", "PATHEXT",
            "USERPROFILE", "APPDATA", "LOCALAPPDATA", "HOMEDRIVE", "HOMEPATH", "XDG_CONFIG_HOME",
            "XDG_STATE_HOME", "XDG_DATA_HOME", "SSH_AUTH_SOCK", "NO_PROXY", "HTTP_PROXY", "HTTPS_PROXY",
            "no_proxy", "http_proxy", "https_proxy", "__CF_USER_TEXT_ENCODING",
            # CA bundles an IT department hands out for TLS-inspecting networks: not credentials,
            # and the CLIs need them to reach their own hosts.
            "SSL_CERT_FILE", "SSL_CERT_DIR", "NODE_EXTRA_CA_CERTS", "CODEX_CA_CERTIFICATE",
            "REQUESTS_CA_BUNDLE", "CURL_CA_BUNDLE"}


def child_env(provider: str, pool: str) -> dict:
    """The environment a job runs with (see KEEP_ENV). The `default` pool is the CLI's own home
    (`~/.claude`, `~/.codex`), reached by leaving the variable unset: Claude Code names an
    explicitly set `CLAUDE_CONFIG_DIR=~/.claude` differently in the Keychain."""
    env = {k: v for k, v in os.environ.items() if k in KEEP_ENV or k.upper() in KEEP_ENV}
    if pool != "default":
        env["CLAUDE_CONFIG_DIR" if provider == "claude" else "CODEX_HOME"] = pool_dir(provider, pool)
    env["BONSAI_POOL"] = pool
    return env


def chat_driven() -> bool:
    """A heuristic, not a proof: Bonsai was started by a Claude Code or Codex session, judging by
    the marks they leave in the environment. It decides when to print a reminder and when to
    refuse a declared-protected job; it cannot tell whose chat it is."""
    if os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_ENTRYPOINT"):
        return True
    return any(k.startswith("CODEX_") and k != "CODEX_HOME" for k in os.environ)


# ── jobs: a ledger the board can read ────────────────────────────────────────────

def jobs_path() -> str:
    return os.path.join(STATE, "jobs.jsonl")


def record_job(entry: dict) -> None:
    _append_private(jobs_path(), json.dumps(entry) + "\n")


def _job_lock_name(jid: str) -> str | None:
    return ("job-%s.lock" % jid) if isinstance(jid, str) and re.fullmatch(r"[0-9a-f]{32}", jid) else None


def job_lock_held(jid) -> bool:
    """Is the Bonsai process that started this job still running? It holds the job's lock for the
    whole run; the kernel releases it when the process ends, so a reused PID proves nothing."""
    name = _job_lock_name(jid)
    if not name:
        return False
    path = os.path.join(STATE, name)
    try:
        flags = os.O_RDWR | (os.O_NOFOLLOW if hasattr(os, "O_NOFOLLOW") else 0)
        fd = os.open(path, flags)
    except OSError:
        return False
    try:
        if IS_WIN:
            import msvcrt
            try:
                msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
                return False
            except OSError:
                return True
        import fcntl
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except (BlockingIOError, OSError):
            return True
    finally:
        os.close(fd)


@contextlib.contextmanager
def job_lock(jid: str):
    name = _job_lock_name(jid)
    if not name:
        yield
        return
    with state_lock(name):
        yield


def read_jobs(limit: int = 200) -> list[dict]:
    """Every job, paired start-to-finish, ordered by each job's most recent event."""
    if limit <= 0:
        return []
    by_id: dict = {}
    try:
        with open(jobs_path(), encoding="utf-8") as f:
            for ln in f:
                try:
                    e = json.loads(ln)
                except ValueError:
                    continue
                if not isinstance(e, dict) or not isinstance(e.get("id"), str):
                    continue
                j = by_id.pop(e["id"], {})
                j.update(e)
                by_id[e["id"]] = j
    except FileNotFoundError:
        return []
    jobs = list(by_id.values())
    for j in jobs:
        if "exit" not in j:
            j["lost"] = not job_lock_held(j.get("id"))
    return jobs[-limit:]


def run_job(argv: list[str], provider: str, pool: str, label: str, stdin_text: str | None = None,
            cwd: str | None = None, capture_to: str | None = None) -> int:
    """Run the job and record its start and finish whatever happens. With `capture_to`, stdout is
    held in a private temp file and published to that path only when the job succeeded."""
    jid = uuid.uuid4().hex
    with job_lock(jid):
        record_job({"id": jid, "at": _iso(_now()), "provider": provider, "pool": pool, "label": label,
                    "cmd": _tool_name(argv[0]) if argv else "", "pid": os.getpid()})
        t0 = _now()
        code = 1
        try:
            if capture_to:
                fd, tmp = tempfile.mkstemp(prefix=".bonsai-out-", dir=os.path.dirname(os.path.abspath(capture_to)) or ".")
                try:
                    with os.fdopen(fd, "w", encoding="utf-8") as out:
                        p = subprocess.run(argv, env=child_env(provider, pool), cwd=cwd,
                                           input=stdin_text, text=True, stdout=out, stderr=subprocess.PIPE)
                    code = p.returncode
                    if code == 0:
                        code = 1
                        if not IS_WIN:
                            os.chmod(tmp, 0o600)
                        os.replace(tmp, os.path.abspath(capture_to))
                        code = 0
                    else:
                        print("bonsai: the job failed (exit %d); the previous output file was left alone" % code, file=sys.stderr)
                        if p.stderr:
                            print("bonsai: the tool's last lines are in its own logs; nothing is echoed here", file=sys.stderr)
                finally:
                    if os.path.exists(tmp):
                        os.unlink(tmp)
            else:
                p = subprocess.run(argv, env=child_env(provider, pool), cwd=cwd,
                                   input=stdin_text, text=True if stdin_text is not None else None)
                code = p.returncode
        except KeyboardInterrupt:
            code = 130
        except FileNotFoundError:
            print("bonsai: %s is not installed (or not on PATH)" % _tool_name(argv[0] if argv else "?"), file=sys.stderr)
            code = 127
        except OSError:
            print("bonsai: could not start the job or publish its output", file=sys.stderr)
            code = 126
        finally:
            record_job({"id": jid, "exit": code, "finished_at": _iso(_now()), "seconds": round(_now() - t0, 1)})
        return code


def _tool_name(path: str) -> str:
    base = os.path.basename(str(path)).lower()
    for ext in (".exe", ".cmd", ".bat"):
        if base.endswith(ext):
            base = base[: -len(ext)]
    return base


# ── the machine row ──────────────────────────────────────────────────────────────

def _sysctl(name: str) -> str:
    try:
        return subprocess.run(["sysctl", "-n", name], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def machine_stats() -> dict:
    """This machine's row. LOAD is the one-minute load average per core (a queue measure, not a
    CPU percentage). macOS reads the stock tools (sysctl, vm_stat, pmset). Windows reads the
    kernel through ctypes: memory, battery and uptime. Anything unreadable is left out."""
    st: dict = {"host": socket.gethostname().split(".")[0]}
    if IS_WIN:
        return _machine_stats_windows(st)
    try:
        st["load"] = os.getloadavg()[0] / (os.cpu_count() or 1)
    except Exception:
        pass
    if not IS_MAC:
        return st
    try:
        total = int(_sysctl("hw.memsize"))
        vm = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=5).stdout
        page = int(re.search(r"page size of (\d+)", vm).group(1))
        free = 0
        for key in ("Pages free", "Pages inactive", "Pages speculative"):
            m = re.search(key + r":\s+(\d+)", vm)
            if m:
                free += int(m.group(1)) * page
        st["mem"] = 100.0 * (total - free) / total
    except Exception:
        pass
    m = re.search(r"used = ([\d.]+)M", _sysctl("vm.swapusage"))
    if m:
        st["swap_gb"] = float(m.group(1)) / 1024.0
    try:
        batt = subprocess.run(["pmset", "-g", "batt"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"(\d+)%;\s*(\w[\w ]*?);", batt)
        if m:
            st["batt"] = int(m.group(1))
            st["ac"] = "AC" in batt.split("\n")[0] or m.group(2) in ("charging", "charged", "finishing charge")
    except Exception:
        pass
    try:
        st["uptime"] = _now() - float(re.search(r"sec = (\d+)", _sysctl("kern.boottime")).group(1))
    except Exception:
        pass
    return st


def _machine_stats_windows(st: dict) -> dict:
    """Provisional, not yet run on a Windows machine: GlobalMemoryStatusEx, GetSystemPowerStatus
    and GetTickCount64 through ctypes. No swap figure (the page-file fields are commit limits,
    not swap in use) and no CPU figure."""
    import ctypes
    kernel = ctypes.windll.kernel32

    class MEMORYSTATUSEX(ctypes.Structure):
        _fields_ = [("dwLength", ctypes.c_uint32), ("dwMemoryLoad", ctypes.c_uint32),
                    ("ullTotalPhys", ctypes.c_ulonglong), ("ullAvailPhys", ctypes.c_ulonglong),
                    ("ullTotalPageFile", ctypes.c_ulonglong), ("ullAvailPageFile", ctypes.c_ulonglong),
                    ("ullTotalVirtual", ctypes.c_ulonglong), ("ullAvailVirtual", ctypes.c_ulonglong),
                    ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]

    class SYSTEM_POWER_STATUS(ctypes.Structure):
        _fields_ = [("ACLineStatus", ctypes.c_ubyte), ("BatteryFlag", ctypes.c_ubyte),
                    ("BatteryLifePercent", ctypes.c_ubyte), ("SystemStatusFlag", ctypes.c_ubyte),
                    ("BatteryLifeTime", ctypes.c_uint32), ("BatteryFullLifeTime", ctypes.c_uint32)]

    try:
        m = MEMORYSTATUSEX()
        m.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
        if kernel.GlobalMemoryStatusEx(ctypes.byref(m)):
            st["mem"] = float(m.dwMemoryLoad)
    except Exception:
        pass
    try:
        p = SYSTEM_POWER_STATUS()
        if kernel.GetSystemPowerStatus(ctypes.byref(p)):
            if p.BatteryFlag != 255 and not (p.BatteryFlag & 128) and 0 <= p.BatteryLifePercent <= 100:
                st["batt"] = int(p.BatteryLifePercent)
            if p.ACLineStatus in (0, 1):
                st["ac"] = p.ACLineStatus == 1
    except Exception:
        pass
    try:
        try:
            kernel.GetTickCount64.restype = ctypes.c_ulonglong
        except Exception:
            pass
        st["uptime"] = float(kernel.GetTickCount64()) / 1000.0
    except Exception:
        pass
    return st



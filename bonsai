def parse_codex_rate_limits(res: dict, pct=None) -> dict:
    """The fields a board needs from the app-server's `account/rateLimits/read` result. `pct`: the caller's
    own percent rule (default `_pct`)."""
    pct = pct or _pct
    row: dict = {}
    rl = res.get("rateLimits") or {}
    row["plan"] = rl.get("planType")
    for w in (rl.get("primary"), rl.get("secondary")):
        if w is None:
            continue
        if not isinstance(w, dict):
            row["incomplete_usage"] = True          # present but not a window (a list, a word): incomplete, never free
            continue
        mins = w.get("windowDurationMins")
        if isinstance(mins, bool) or not isinstance(mins, (int, float)) or not math.isfinite(mins) or mins <= 0:
            row["incomplete_usage"] = True
            continue
        out = "5h" if mins <= 6 * 60 else "wk"
        row[out] = pct(w.get("usedPercent"))
        row[out + "_at"] = _when_ts(w.get("resetsAt"))
        if row[out] is None:
            row["incomplete_usage"] = True
    if rl.get("rateLimitReachedType") or rl.get("spendControlReached"):
        row["limited"] = True
    return row


# The one npm package script Bonsai starts on Windows, by CLI (Claude Code: its native installer's claude.exe).
NPM_ENTRY = {"codex": os.path.join("node_modules", "@openai", "codex", "bin", "codex.js")}


def cli_command(name: str) -> list | None:
    """The argv prefix that starts CLI `name`, or None when it is not installed or cannot be started safely. On Windows
    npm installs a CLI as a `name.cmd` batch file, and cmd.exe would re-read every argument of one (Python's subprocess
    docs warn of it), so Bonsai starts the package's own script with Node instead: the script at its fixed place
    beside the batch file, never a path read out of it, and a node.exe, never another batch file."""
    path = which_cli(name)
    if not path or not IS_WIN or not path.lower().endswith((".cmd", ".bat")):
        return [path] if path else None
    script = os.path.join(os.path.dirname(os.path.abspath(path)), NPM_ENTRY.get(name, "-"))
    node = os.path.join(os.path.dirname(os.path.abspath(path)), "node.exe")
    node = node if os.path.isfile(node) else (shutil.which("node") or "")
    if not (os.path.isfile(script) and os.path.isabs(node) and node.lower().endswith(".exe")):
        return None
    return [node, script]



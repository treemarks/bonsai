PROG = "bonsai"              # the program's name in its own messages
FILE_LIMIT = 400_000         # bytes of one -f file that go into a prompt
PROMPT_LIMIT = 1_600_000     # bytes of the whole prompt


def _open_regular(path: str):
    """The file at `path`, opened for reading only if it is a regular file. The open itself does not wait: it is
    non-blocking and follows no link at the last step, and what it opened is checked on the descriptor, so neither a
    FIFO nor a link put in its place after the check is read."""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        raise SystemExit("%s: cannot read %s" % (PROG, display_text(path, 80))) from None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise SystemExit("%s: -f takes a regular text file, not %s" % (PROG, display_text(path, 80)))
        return os.fdopen(fd, "rb")
    except BaseException:
        os.close(fd)
        raise


# Folders and files that hold sign-ins or keys: -f refuses them however they are reached (a link named notes.md too).
SECRET_DIRS = tuple(os.path.realpath(os.path.expanduser(d)) for d in (
    "~/.claude-pools", "~/.codex-pools", "~/.claude", "~/.codex", "~/.ssh", "~/.aws", "~/.config/gh", "~/.gnupg",
    "~/Library/Keychains"))
SECRET_NAMES = ("auth.json", ".credentials.json", ".netrc", ".env", "id_rsa", "id_ed25519")


def _read_file_bounded(path: str) -> str:
    real = os.path.realpath(path)
    low, dirs = real.casefold(), [d.casefold() for d in SECRET_DIRS]
    if os.path.basename(low) in SECRET_NAMES or any(low == d or low.startswith(d + os.sep) for d in dirs):
        raise SystemExit("%s: %s is (or leads to) a sign-in or key file; -f will not send it" % (PROG, display_text(path, 80)))
    try:
        fh = _open_regular(real)                             # the file checked, not a name that could be re-pointed
    except OSError:
        raise SystemExit("%s: cannot read %s" % (PROG, display_text(path, 80))) from None
    with fh:
        raw = fh.read(FILE_LIMIT + 1)
    cut = len(raw) > FILE_LIMIT
    raw = raw[:FILE_LIMIT]
    if b"\0" in raw:
        raise SystemExit("%s: %s looks binary; -f takes text" % (PROG, display_text(path, 80)))
    try:
        body = codecs.getincrementaldecoder("utf-8")("strict").decode(raw, final=not cut)
    except UnicodeDecodeError:
        raise SystemExit("%s: %s is not UTF-8 text" % (PROG, display_text(path, 80))) from None
    if cut:
        body += "\n[... truncated by %s at %d bytes ...]" % (PROG, FILE_LIMIT)
    return body


def read_prompt(a) -> str:
    """The task text: the prompt word(s), stdin when asked for (`-`) or when nothing else was
    given and stdin is a pipe, and each -f file as a JSON object (name and content), so a file
    name or body cannot pretend to be prompt structure."""
    parts = []
    prompt = getattr(a, "prompt", None)
    files = list(getattr(a, "file", None) or [])
    if prompt and prompt != "-":
        parts.append(prompt)
    read_stdin = prompt == "-" or (not prompt and not files and sys.stdin is not None and not sys.stdin.isatty())
    if read_stdin:
        try:
            text = sys.stdin.read(PROMPT_LIMIT + 1)
        except (OSError, ValueError, AttributeError):
            raise SystemExit("%s: stdin is not available; give the prompt as an argument or with -f" % PROG) from None
        if len(text) > PROMPT_LIMIT:
            raise SystemExit("%s: stdin is over the prompt limit (%d bytes)" % (PROG, PROMPT_LIMIT))
        parts.append(text)
    for f in files:
        parts.append("FILE " + json.dumps({"file": f, "content": _read_file_bounded(os.path.expanduser(f))}, ensure_ascii=True))
    text = "\n\n".join(x for x in parts if x).strip()
    if not text:
        raise SystemExit("%s: give a prompt, -f files, or text on stdin" % PROG)
    if len(text.encode("utf-8")) > PROMPT_LIMIT:
        raise SystemExit("%s: the prompt and files are over %d bytes together" % (PROG, PROMPT_LIMIT))
    return text



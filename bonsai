# field -> what it is. Text may be one string or a list of lines; the leaves of a mapping are text.
PROFILE_FIELDS = {"id": "text", "name": "text", "label": "text", "domain": "text", "domains": "map", "words": "map",
                  "signup": "map of maps", "phi_note": "map", "phrases": "map"}

# What the program says where a profile has no phrase of its own.
GENERIC_PHRASES = {}


def _profile_text(v):
    """A profile's text value as one string (a list of lines is joined)."""
    if isinstance(v, list) and all(isinstance(x, str) for x in v):
        v = "\n".join(v)
    return v if isinstance(v, str) else None


def profile_words(p: dict) -> dict:
    """The words a profile gives the tokens in Bonsai's text: `{{label}}`, `{{domain}}`, `{{name}}` in examples,
    and how the institution reads in a sentence (`{{inst}}`, `{{Inst}}`, `{{inst_poss}}`, `{{inst_adj}}`,
    `{{Inst_adj}}`, `{{a_inst_adj}}`). With no name the words are generic and the example is Acme."""
    name = p.get("name") or ""
    domains = p.get("domains") or {}
    words = {"label": p.get("label") or next(iter(domains.values()), "") or "acme",
             "domain": p.get("domain") or next(iter(domains), "") or "acme.example",
             "name": name or "Acme",
             "inst": name or "your institution", "Inst": name or "Your institution",
             "inst_poss": (name + "'s") if name else "your institution's",
             "inst_adj": name or "institution", "Inst_adj": name or "Institution",
             "a_inst_adj": ("a " + name) if name else "an institution"}
    words.update({k: v for k, v in (p.get("words") or {}).items() if isinstance(v, str)})
    return words


def complete_profile(p: dict) -> dict:
    """A profile with every text value as one string and its words filled in."""
    out = {}
    for k, v in p.items():
        kind = PROFILE_FIELDS.get(k)
        if kind == "text":
            out[k] = _profile_text(v) or ""
        elif kind == "map":
            out[k] = {a: _profile_text(b) or "" for a, b in v.items()}
        elif kind == "map of maps":
            out[k] = {a: {x: _profile_text(y) or "" for x, y in b.items()} for a, b in v.items()}
    out["phrases"] = dict(GENERIC_PHRASES, **(out.get("phrases") or {}))
    out["words"] = profile_words(out)
    return out


PROFILE = complete_profile(BUILTIN_PROFILE)


def T(text: str) -> str:
    """Text with the profile's phrases (`{{p:name}}`) and words (`{{label}}`, ...) filled in. The build refuses a
    phrase the program uses that neither the profile nor the generic phrases carry."""
    for k, v in (PROFILE.get("phrases") or {}).items():
        text = text.replace("{{p:%s}}" % k, v)
    text = re.sub(r"\{\{p:[A-Za-z0-9_.]+\}\}", "", text)
    for k, v in PROFILE["words"].items():
        text = text.replace("{{%s}}" % k, v)
    return text



STALE_SECONDS = 15 * 60
WARN_USED_PCT = 80.0
REPORTED = "as last reported by Claude Code"


def _store_path() -> str:
    return os.path.join(STATE, "claude_usage.json")


def readings() -> dict:
    d = _read_json(_store_path(), {})
    return d if isinstance(d, dict) else {}


def record_reading(pool: str, reading: dict) -> dict:
    reading = dict(reading, at=_now())
    if reading.get("status") == "rejected" and not reading.get("limited_until"):
        reading["limited_until"] = reading["at"] + STALE_SECONDS     # no reset given: wait for the next reading
    with state_lock(_store_path() + ".lock"):
        d = readings()
        d[pool] = reading
        _write_json(_store_path(), d)
    return reading


def from_event(info: dict) -> dict | None:
    """A reading from a job stream's `rate_limit_event.rate_limit_info`: the week's (and five hours') percent used,
    their resets, and the login's status; a `rejected` login waits until the reset the event names."""
    if not isinstance(info, dict):
        return None
    out = {"status": str(info.get("status") or ""), "source": "job"}
    windows = info.get("unifiedWindows") if isinstance(info.get("unifiedWindows"), dict) else {}
    for key, name in (("seven_day", "wk"), ("five_hour", "5h")):
        w = windows.get(key) if isinstance(windows.get(key), dict) else {}
        u = w.get("utilization")                 # a fraction here, where /usage gives a percent
        if isinstance(u, (int, float)) and not isinstance(u, bool) and _pct(u * 100) is not None:
            out[name] = _pct(u * 100)
            if _when_ts(w.get("resetsAt")):
                out[name + "_at"] = _when_ts(w["resetsAt"])
    if out["status"] == "rejected" and _when_ts(info.get("resetsAt")):
        out["limited_until"] = _when_ts(info["resetsAt"])
    return out if ("wk" in out or "5h" in out or out["status"]) else None


def from_report(report: dict) -> dict | None:
    """A reading from `/usage`'s `usage_report`: the account-wide weekly (`weekly_all`) and session (`session`) rows,
    classified on their kind; a model's own cap (`weekly_scoped`) and spend are not the login's room. A row at 100%
    makes the login wait until that row's reset."""
    limits = ((report or {}).get("rate_limits") or {}).get("limits") if isinstance(report, dict) else None
    out = {"status": "", "source": "usage"}
    for row in limits if isinstance(limits, list) else []:
        name = {"weekly_all": "wk", "session": "5h"}.get(row.get("kind")) if isinstance(row, dict) else None
        if not name or _pct(row.get("percent")) is None:
            continue
        out[name] = _pct(row["percent"])
        at = _when_ts(row.get("resets_at"))
        if at:
            out[name + "_at"] = at
            if out[name] >= 100.0:
                out["limited_until"] = max(out.get("limited_until") or 0.0, at)
    return out if ("wk" in out or "5h" in out) else None


def read_usage_now(pool: str, timeout: float | None = None) -> dict | None:
    """Ask Claude Code for this login's usage report (`/usage`, no model turn, at most a minute or `timeout`) and keep
    it. None when it did not answer; the attempt is kept too, so a board does not ask again on every repaint."""
    claude = cli_command("claude")
    reading = None
    try:
        with private_cwd() as cwd:
            argv = [*claude, "-p", *usage_read_args(), "--settings", HOOKS_OFF, "--output-format", "stream-json", "--verbose"]
            require_usage_read(argv, cwd)            # no tool, one turn, an empty folder, even if "/usage" were a prompt
            r = subprocess.run(argv, input="/usage\n", env=child_env("claude", pool), cwd=cwd, capture_output=True,
                               encoding="utf-8", errors="replace", timeout=max(1.0, min(60.0, timeout or 60.0)))
        for line in (r.stdout or "").splitlines() if r.returncode == 0 else []:
            d = json.loads(line) if line.startswith("{") else None
            if isinstance(d, dict) and "usage_report" in d:
                reading = from_report(d["usage_report"])
    except (OSError, ValueError, TypeError, subprocess.TimeoutExpired, LaunchRefused):
        pass
    if reading:
        return record_reading(pool, reading)
    with state_lock(_store_path() + ".lock"):
        d = readings()
        d[pool] = dict(d.get(pool) or {}, tried=_now())
        _write_json(_store_path(), d)
    return None


def stale(pool: str, now: float | None = None) -> bool:
    r = readings().get(pool)
    last = max(float(r.get("at") or 0), float(r.get("tried") or 0)) if isinstance(r, dict) else 0.0
    return ((_now() if now is None else now) - last) > STALE_SECONDS


def live(r: dict, now: float | None = None) -> dict:
    """The windows of a reading whose reset has not passed (a passed reset says nothing about now)."""
    now = _now() if now is None else now
    out = {}
    for k in ("wk", "5h"):
        if isinstance(r.get(k), (int, float)) and not (isinstance(r.get(k + "_at"), (int, float)) and r[k + "_at"] <= now):
            out[k] = r[k]
            if r.get(k + "_at"):
                out[k + "_at"] = r[k + "_at"]
    return out


def apply_readings(state: dict, now: float | None = None) -> dict:
    """Put each Claude login's latest reading beside its row (`reading`, for the board), and mark a login that ran out
    `LIMITED` until its reset. A row's own numbers and state are otherwise left as the probe gave them, so the order
    a job takes is unchanged."""
    now = _now() if now is None else now
    have = readings()
    for row in state.get("rows", []):
        if not isinstance(row, dict) or row.get("provider") != "claude" or row.get("state") not in ("signed-in", "LIMITED"):
            continue
        r = have.get(row.get("pool"))
        if row.pop("limited_by_reading", None):
            row["state"] = "signed-in"
            row.pop("limited_until", None)
        if not isinstance(r, dict):
            continue
        row["reading"] = dict(live(r, now), at=r.get("at"), status=r.get("status"))
        if isinstance(r.get("limited_until"), (int, float)) and r["limited_until"] > now and row["state"] == "signed-in":
            row.update(state="LIMITED", limited_by_reading=True, limited_until=r["limited_until"])
    return state


def limit_line(name: str, row_or_reading: dict, always: bool = False) -> str | None:
    """One line on a Claude login's week: always after a job, otherwise only when it is running low or has run out."""
    r = row_or_reading.get("reading") or row_or_reading
    used = r.get("wk") if isinstance(r.get("wk"), (int, float)) else None
    five = r.get("5h") if isinstance(r.get("5h"), (int, float)) else None
    out_until = row_or_reading.get("limited_until") or r.get("limited_until")
    label = display_text(name, 24)
    if row_or_reading.get("state") == "LIMITED" or r.get("status") == "rejected":
        at = out_until if isinstance(out_until, (int, float)) and out_until > _now() else None
        return "bonsai: %s has run out of Claude usage; it resets %s." % (label, ("in " + _age(at - _now())) if at else "later")
    wk = (" %.0f%% of the week used, %s" % (used, REPORTED)) if used is not None else ""
    at = r.get("wk_at")
    when = ("; it resets in %s" % _age(at - _now())) if isinstance(at, (int, float)) and at > _now() else ""
    if five is not None and five >= WARN_USED_PCT and (used is None or used < WARN_USED_PCT):
        wk, when = " %.0f%% of its five hours used, %s" % (five, REPORTED), ""
    if r.get("status") == "allowed_warning" or max(used or 0, five or 0) >= WARN_USED_PCT:
        return "bonsai: %s is running low on Claude usage:%s%s." % (label, wk or " " + REPORTED, when)
    return ("bonsai: %s:%s%s." % (label, wk, when)) if always and wk else None


def read_stream(raw: str) -> tuple:
    """(the answer, the last rate-limit info) from a Claude job's stream-json output."""
    answer, info = "", None
    for line in (raw or "").splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if not isinstance(d, dict):
            continue
        if d.get("type") == "rate_limit_event":
            info = d.get("rate_limit_info")
        elif d.get("type") == "result" and isinstance(d.get("result"), str):
            answer = d["result"]
    return answer, info


# What Codex and Claude Code print when a login has used its allowance.
_RAN_OUT = re.compile(r"(?:hit your (?:usage|session) limit|usage limit|session limit)[^\n]*", re.I)


def ran_out_text(messages: str) -> str | None:
    m = _RAN_OUT.search(messages or "")
    return display_text(m.group(0).strip(), 160) if m else None


def say(line: str | None) -> None:
    if line:
        print(line, file=sys.stderr)



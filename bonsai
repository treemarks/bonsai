def cmd_doctor(a, cfg) -> int:
    print("bonsai %s · python %s · %s" % (VERSION, platform.python_version(), platform.platform()))
    if sys.version_info < (3, 9):
        print("  python  too old: Bonsai needs 3.9 or newer. " + INSTALL["python3"]["windows" if IS_WIN else "darwin"])
    missing, absent = [], []          # each provider's CLI is needed only for an account with that provider
    clis = {PROVIDERS[p]["cli"]: PROVIDERS[p].get("label_long", p) for p in PROVIDERS}
    for tool in ["git"] + list(clis):
        path = which_cli(tool)
        ver = ""
        if path and not cli_command(tool):
            missing.append(tool)
            print("  %-7s %s  (a batch-file launcher Bonsai does not start: see docs/WINDOWS.md)" % (tool, path))
        elif path:
            try:
                r = subprocess.run([*(cli_command(tool) or [path]), "--version"], capture_output=True, encoding="utf-8", errors="replace", timeout=15)
                ver = (r.stdout.strip().splitlines() or ["?"])[0] if r.returncode == 0 else "(did not answer --version)"
                if r.returncode != 0:
                    missing.append(tool)
            except Exception:
                ver = "(did not answer --version)"
                missing.append(tool)
            print("  %-7s %s  %s" % (tool, path, display_text(ver, 60)))
        elif tool in clis:
            absent.append(tool)
            print("  %-7s not installed (needed only for a %s account)" % (tool, "Claude" if tool == "claude" else "ChatGPT"))
        else:
            missing.append(tool)
            print("  %-7s NOT INSTALLED" % tool)
    if len(absent) == len(clis):
        missing += absent                 # neither provider's CLI: nothing could run a job
    if missing:
        print("to install (SETUP.md has the whole walk):")
        for tool in missing:
            print("  %-7s %s" % (tool, INSTALL[tool]["windows" if IS_WIN else "darwin"]))
            if INSTALL[tool].get("alt"):
                print("  %-7s %s" % ("", INSTALL[tool]["alt"]))
    print("  state   %s\n  config  %s" % (STATE, CONFIG_PATH))
    bad = validate_config(cfg)
    if bad:
        print("  config  has unknown or malformed keys: %s" % ", ".join(sorted(bad)))
    print("logins:")
    pools = discover_pools()
    signed_in = 0
    if not pools:
        print("  none yet. `bonsai login <email> --claude` or `bonsai login <email> --codex`.")
    for provider, pool, d in pools:
        state, ok = behavior(provider)["doctor"](pool, d)
        wrong = (((cfg.get("logins") or {}).get(pool) or {}).get("mismatch") or {}).get(provider)
        if ok and not wrong:
            signed_in += 1
        flags = (" ⌂ institution (marked by you; workspace approval not verified)" if is_institution(cfg, pool, provider) else "")
        if wrong:
            flags += " ✗ signed in as another account: sign it in again in a private window"
        print("  %-7s %-32s %-10s %s%s" % (provider, display_text(pool, 32), display_text(login_name(cfg, pool), 10),
                                           display_text(state, 80), flags))
    if any(is_institution(cfg, p, prov) for prov, p, _ in pools):
        print("note: a job you ask a chat to run on an institution account is seen by that chat, under the chat's own"
              " account; the institution's protections do not extend to the chat (README, the box at the top).")
    for prov in ("claude", "codex"):
        if not any(is_institution(cfg, p, pv) for pv, p, _ in pools if pv == prov):
            print("no %s %s login yet: SETUP.md §5%s signs it in%s" % (
                PROFILE.get("name") or "institution", BEHAVIOR[prov]["signup_title"], "c" if prov == "claude" else "d",
                ("; to request one: " + request_url(prov)) if request_url(prov) else ""))
    print("auto: prefer=%s (%s)" % (cfg.get("prefer") or "soonest", PREFER_WORDS.get(cfg.get("prefer") or "soonest", "")))
    for agent, skill in skill_targets():
        print("skill:   %s %s" % (skill, {"matches": "matches this version (%s)" % agent,
                                         "differs": "DIFFERS from this version: run `bonsai install-skill`",
                                         "missing": "not installed (bonsai install-skill teaches %s the words)" % agent}[
                                            skill_state(skill)]))
    if in_codex_sandbox():
        print("note: this runs inside Codex's sandbox, which hides the network and the Keychain: the login lines above "
              "can read no-login when they are signed in. Run bonsai outside the sandbox (approve it when Codex asks).")
    print("models:  " + ", ".join("%s=%s" % (display_text(alias, 8), display_text(mid, 40))
                                  for alias, (prov, mid) in sorted((cfg.get("models") or {}).items())))
    print("summary: tools %s · pools %d, signed in %d · exit 0 means git and a provider's CLI answered; read the login lines yourself"
          % ("ok" if not missing else "MISSING " + ",".join(missing), len(pools), signed_in))
    return 1 if missing else 0   # git and at least one provider's CLI answered


PREFER_WORDS = {"soonest": "whichever login's room resets first, personal and institution alike",
                "institution": "institution seats first, then the rest",
                "personal": "personal logins first, the seats when those are spent or waiting"}


def request_url(provider: str) -> str:
    """Where this profile's institution account for `provider` is requested, or nothing."""
    for e in INSTITUTION_SIGNUP.values():
        m = re.search(r"https?://\S+?(?=[\s.,;)]*(?:\s|$))", e.get(provider) or "")
        if m:
            return m.group(0)
    return ""


def cmd_login(a, cfg) -> int:
    if a.email.split("@")[0].casefold() == "you" or re.search(r"your_|[<>]", a.email, re.I):
        raise SystemExit("bonsai: %s is the guide's example; use your own%s address." % (
            display_text(a.email, 60), (" " + T("{{inst_adj}}")) if a.institution else ""))
    provider = "claude" if a.claude else "codex"
    how = behavior(provider)
    tool = cli_command(PROVIDERS[provider]["cli"])
    if not tool and which_cli(PROVIDERS[provider]["cli"]):
        raise SystemExit("bonsai: %s is installed through a batch-file launcher Bonsai does not start: see docs/WINDOWS.md" % provider)
    if not tool:
        raise SystemExit("bonsai: %s is not installed. %s" % (provider, INSTALL[provider]["windows" if IS_WIN else "darwin"]))
    # The pool is the e-mail unless --pool names another directory: one account can hold two
    # workspaces (ChatGPT shows "Select a workspace"), and each sign-in binds to one of them.
    pool = check_pool_name(getattr(a, "pool", None) or a.email)
    if pool == "default":
        raise SystemExit("bonsai: `default` is the CLI's own sign-in; run `%s` itself to sign that in" % provider)
    name = a.name or login_name(cfg, pool)
    if a.name:
        check_pool_name(a.name)  # a label obeys the same rules as a pool name (no routing words)

    def taken(label):
        return [other for other, entry in (cfg.get("logins") or {}).items() if other != pool and
                (other.casefold() == label.casefold() or (entry.get("name") or "").casefold() == label.casefold())]
    if taken(name):
        if a.name:
            raise SystemExit("bonsai: the label %r already names the pool %s; give this sign-in its own --name"
                             % (name, taken(name)[0]))
        name = pool  # two logins at one domain: the second is labelled by its full address, never ambiguous
    d = pool_dir(provider, pool)
    private_dir(d)
    ensure_notice(cfg, "login", sys.stdout)       # every sign-in: a re-sign of a seat may not say --institution
    if a.institution:
        print("bonsai: open the sign-in link in a private (incognito) window, so the browser can't use an account it's already in.")
    argv = how["login_argv"](tool, a)
    print("bonsai: signing %s in as %s (pool %s). Check the e-mail, and for ChatGPT the workspace, before you approve."
          % (provider, pool, d))
    sys.stdout.flush()
    rc = subprocess.call(argv, env=child_env(provider, pool))
    if rc != 0:
        print("bonsai: sign-in didn't finish (exit %d); nothing was recorded. Run the same line again, then check "
              "`bonsai doctor`." % rc, file=sys.stderr)
        return rc
    print(CODE_LINE)
    found = login_identity(provider, pool, d)
    if found.get("email") and found["email"].casefold() != a.email.casefold():
        cfg.clear()
        cfg.update(update_config(lambda fresh: fresh.setdefault("logins", {}).setdefault(pool, {}).setdefault(
            "mismatch", {}).__setitem__(provider, found["email"])))
        print("bonsai: that %s sign-in came back as %s, not %s, so jobs won't use it. Run the same line again in a private "
              "window, or sign it out:\n  %s" % (provider, found["email"], a.email, logout_line(provider, pool)), file=sys.stderr)
        return 1

    def record(fresh):
        entry = fresh.setdefault("logins", {}).setdefault(pool, {})
        entry["name"] = name
        entry.setdefault("institutions", {})[provider] = bool(a.institution)
        (entry.get("mismatch") or {}).pop(provider, None)
    cfg.clear()
    cfg.update(update_config(record))       # the config as it is now, with this login in it
    try:
        os.remove(cache_path())  # the board re-probes: a row for this pool must not stay stale for an interval
    except OSError:
        pass
    print("bonsai: %s pool %s recorded as %s%s" % (provider, pool, name, " (marked institution by you)" if a.institution else ""))
    print("bonsai: signed in as %s" % describe_identity(found))
    if a.institution:
        print(how["institution_note"])
    return 0


CODE_LINE = "bonsai: if the browser shows a code, close it; never paste a code at the % prompt."


def login_identity(provider: str, pool: str, d: str) -> dict:
    """What the CLI says is signed in to this pool, as labels: e-mail, org/plan, workspace id."""
    return behavior(provider)["identity"](pool, d)


def describe_identity(found: dict) -> str:
    parts = [display_text(found.get("email") or "?", 60)]
    if found.get("org"):
        parts.append("org %s" % display_text(found["org"], 40))
    if found.get("plan"):
        parts.append("plan %s" % display_text(found["plan"], 16))
    if found.get("workspace"):
        parts.append("workspace id %s" % display_text(found["workspace"], 8))
    return " · ".join(parts)


def logout_line(provider: str, pool: str) -> str:
    """The exact sign-out command for one pool, with the pool directory spelled out (no routing)."""
    return behavior(provider)["logout_line"](pool)


def _data_gate(data, provider) -> None:
    """Apply a --data declaration before anything is read or probed. `low` or no declaration:
    route as asked. `moderate`, `high`, `phi`: refused wherever the command runs from (a Terminal
    is not a sign of approval any more than a chat is). `restricted`: refused everywhere."""
    if data in (None, "low"):
        return
    if data == "restricted":
        raise SystemExit("bonsai: refused: payment-card data, CUI and export-controlled material are approved for no AI tool.")
    note = ("\n" + PHI_NOTE.get(provider or "", "")) if data == "phi" else ""
    raise SystemExit(PRIVATE_HANDOFF % (data, note))


def ensure_notice(cfg: dict, how: str, stream=None) -> None:
    """Print the notice once on this machine (per NOTICE_VERSION), before the first sign-in or the first
    job, and record that it was shown. It reaches whoever is at the terminal, which may be an agent; the skill tells
    the agent to relay it, and the docs tell the human to expect it."""
    if (cfg.get("notice_shown") or {}).get("version") == NOTICE_VERSION:
        return
    print(T(INSTITUTION_NOTICE), file=stream or sys.stderr)
    shown = {"version": NOTICE_VERSION, "how": how, "at": _iso(_now())}
    cfg["notice_shown"] = shown
    try:
        update_config(lambda fresh: fresh.__setitem__("notice_shown", shown))
    except SystemExit:
        pass


def say_login(provider: str, row: dict, chat: bool, extra: str = "") -> None:
    print("bonsai: %s on %s (%s): %s%s" % (provider, display_text(row.get("name") or row["pool"], 24),
                                          display_text(row["pool"], 40), row.get("why") or "named", extra), file=sys.stderr)


def resolve_model(cfg: dict, provider: str, model: str | None) -> str:
    models = cfg.get("models") or {}
    if model and model.lower() in models:
        prov, mid = models[model.lower()]
        if prov != provider:
            raise SystemExit("bonsai: %s is a %s model; the target is on %s" % (model, prov, provider))
        return mid
    return model or (cfg.get("default_model") or {}).get(provider) or behavior(provider)["default_model"]


def headless_argv(provider: str, model: str, effort: str, out: str | None, cwd: str, web: bool = False) -> list:
    """The exact command a job runs: the fleet's text-only launch shape (poolcore.launch). Codex: `codex exec` in its
    read-only sandbox with the shell tool off, nothing of your config or rules, no web (OpenAI's cached search alone with
    --web), signed in with ChatGPT (never
    an API key), the final message to `-o`. Claude: `claude -p` with every tool off and named as a denial, no MCP
    servers, slash commands or hooks, bounded turns, no session saved. Both run in an empty folder of their own."""
    return behavior(provider)["job_argv"](model, effort, out, cwd, **({"web": True} if web else {}))


def cmd_job(a, cfg, prompt: str | None = None, label: str | None = None) -> int:
    provider, want, model = resolve_target(a.target, cfg, a.model)
    want = a.pool or want
    model = resolve_model(cfg, provider, model)
    effort = a.effort or cfg.get("default_effort") or "medium"
    chat = chat_driven()
    web = bool(getattr(a, "web", False))
    if web and provider != "codex":
        raise SystemExit("bonsai: --web is for ChatGPT/Codex jobs; a routed Claude job has no web search")
    if web and (getattr(a, "file", None) or prompt is not None or getattr(a, "prompt", None) in (None, "", "-")):
        raise SystemExit("bonsai: --web takes the question as its one argument: no -f and no stdin, so a job that can "
                         "search is handed no file")
    if web and codex_host_missing():
        say("bonsai: this Codex has no codex-code-mode-host beside it; a model that searches through it (gpt-6.1-sol "
            "does) answers without search. SETUP step 3 adds it.")
    _data_gate(getattr(a, "data", None), provider)               # before any read or probe
    if in_codex_sandbox() and not getattr(a, "dry_run", False):  # no network, no Keychain: say so, not "exit 1"
        raise SystemExit(CODEX_SANDBOX_MESSAGE)
    if not getattr(a, "dry_run", False):
        ensure_notice(cfg, "job")
    text = prompt if prompt is not None else read_prompt(a)      # a bad file stops us before any probe
    out = os.path.abspath(os.path.expanduser(a.out)) if a.out else None
    if out and not getattr(a, "dry_run", False):
        os.makedirs(os.path.dirname(out), exist_ok=True)          # `-o ~/Bonsai/x.md` needs no mkdir first

    def choose(j=None):
        step = j.within if j else (lambda fn, *args: fn(*args))
        state = step(refresh, cfg)
        # Picked as if there were no Claude readings: a reading never moves a job to another login (ruled); one that
        # has run out stops the job with its reset.
        row = pick(dict(state, rows=[dict(r, state="signed-in") if r.get("limited_by_reading") else r
                                     for r in state.get("rows", [])]), provider, want, cfg)
        name = row.get("name") or row["pool"]
        if provider == "claude":
            if stale(row["pool"]):
                step(read_usage_now, row["pool"], j.left() if j else None)    # `/usage`, no model turn
                if j:
                    j.check()
            now = next(r for r in apply_readings(state)["rows"] if r.get("provider") == "claude" and r.get("pool") == row["pool"])
            if now.get("state") == "LIMITED":
                raise SystemExit("%s Name another login with --pool, or change `prefer`." % limit_line(name, now))
            row["reading"] = now.get("reading")
            say(limit_line(name, row))
        say_login(provider, row, chat, ", %s, effort %s%s%s" % (model, effort, ", web search" if web else "",
                                                               (", → " + display_text(out, 80)) if out else ""))
        return row, name
    if getattr(a, "dry_run", False):
        row, name = choose()
        print("would run %s on %s (%s): %s" % (provider, display_text(name, 24), display_text(row["pool"], 40),
                                               row.get("why") or "named"))
        print(" ".join(shlex.quote(w) for w in headless_argv(provider, model, effort, out, "<an empty folder of its own>", web)))
        return 0
    limit = getattr(a, "timeout", None)
    limit = cfg.get("job_timeout", DEFAULT_JOB_TIMEOUT_MINUTES) if limit is None else limit
    with start_job(provider, label or a.target, limit) as j, private_cwd() as cwd:
        row, name = choose(j)
        staged = j.path("answer") if provider == "codex" and out else None   # Codex's -o, published only on ok
        argv = headless_argv(provider, model, effort, staged, cwd, web)
        try:
            require(provider, argv, cwd, web)                    # the guard, before anything is spawned
        except LaunchRefused as e:
            raise SystemExit("bonsai: %s" % e)
        env = child_env(provider, row["pool"])
        env.update(env_additions())

        def after(outcome, output, messages):
            if provider == "claude":
                answer, info = read_stream(output)
                reading = from_event(info)
                say(limit_line(name, record_reading(row["pool"], reading), always=True) if reading else
                    "bonsai: %s: usage unavailable (Claude Code reported none for this job)" % display_text(name, 24))
            else:
                answer = _text_of(staged) if staged else output
            said = ran_out_text(messages + "\n" + output) if outcome != "ok" else None
            if said:
                say("bonsai: %s has run out of %s usage (%s)" % (name, provider.capitalize(), said))
            return answer
        return run_job(argv, provider, row["pool"], label or a.target, stdin_text=text, cwd=cwd, capture_to=out,
                       env=env, after=after, job=j, web=web)



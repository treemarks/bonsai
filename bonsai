# The states in which a named login is taken: serving (`OK`), signed in with no usage read, or `unknown` (the probe
# could not tell; the job is tried, with a note). Every other state (signed out, lapsed, unauthorized, a bad
# credential file, no plan, the CLI missing, offline, a credential this shell cannot read) cannot take a job.
NAMED_OK = ("OK", "signed-in", "unknown")


def pick(state: dict, provider: str, want: str | None, cfg: dict) -> dict:
    """The login a job takes: `want` (a login's label, its pool name, or its account e-mail; exact matches only), or,
    with no `want`, the first in the order `poolcore.routing.route` gives under the `prefer` setting. A login whose
    sign-in came back as another account (marked at `bonsai login`) is never used until it is signed in again."""
    rows = [r for r in state.get("rows", []) if r.get("provider") == provider]
    prefer = cfg.get("prefer") if cfg.get("prefer") in PREFERENCES else "soonest"
    if want and want not in ("auto", ""):
        # Exact pool or name first; then the exact account e-mail. No prefixes: a label must
        # not drift to `<label>-pro` because a second pool appeared (Astra, sign-in pass).
        w = want.casefold()
        hits = [r for r in rows if r.get("pool", "").casefold() == w or (r.get("name") or "").casefold() == w]
        if not hits:
            hits = [r for r in rows if (r.get("account") or "").casefold() == w]
        if not hits:
            raise SystemExit("bonsai: no %s login called %r is set up here; `bonsai doctor` lists them "
                             "(use the full pool name or label; prefixes are not matched)" % (provider, want))
        if len(hits) > 1:
            raise SystemExit("bonsai: %r matches several %s logins: %s" % (want, provider, ", ".join(sorted(r["pool"] for r in hits))))
        r = hits[0]
        if r.get("mismatch"):
            raise SystemExit("bonsai: %s/%s is signed in as another account (%s), not the one it was set up for; sign it in "
                             "again in a private window (SETUP.md §5) before using it" % (
                                 provider, r["pool"], display_text(r["mismatch"], 60)))
        if r.get("state") == "LIMITED":
            raise SystemExit("bonsai: %s/%s is at its limit; a named login is not a way around a stop" % (provider, r["pool"]))
        if r.get("state") not in NAMED_OK:
            raise SystemExit("bonsai: %s/%s reads %s, so a job there would fail; `bonsai doctor` says what it needs"
                             % (provider, r["pool"], r.get("state")))
        left, _ = room(r)
        if r.get("state") == "OK" and (r.get("incomplete_usage") or left is None):
            raise SystemExit("bonsai: %s/%s's last usage reading was incomplete; `bonsai gauge --once --fresh` reads it "
                             "again" % (provider, r["pool"]))
        if r.get("state") == "OK" and left <= 0:
            raise SystemExit("bonsai: %s/%s has nothing left until its reset; naming it spends what is left above its "
                             "floor, not past its limit" % (provider, r["pool"]))
        if r.get("state") not in ("OK", "signed-in"):
            print("bonsai: note: %s/%s read %s on the last probe; trying it anyway" % (provider, r["pool"], r.get("state")), file=sys.stderr)
        return dict(r, why="named")
    order = route(state, provider, prefer)
    if not order:
        names = ", ".join(sorted("%s (%s)" % (r.get("name") or r["pool"], r.get("state")) for r in rows)) or "none set up"
        raise SystemExit("bonsai: no %s login can take a job right now: %s. `bonsai doctor` says what each needs; a "
                         "login you name with --pool is used if it is signed in." % (provider, display_text(names, 300)))
    if order[0]["held"]:
        first = order[0]
        raise SystemExit("bonsai: every %s login is under its floor now; the soonest weekly reset is %s. Wait, or name a "
                         "login with --pool to spend what is left." % (
                             provider, ("in " + _age(first["wk_at"] - _now())) if first.get("wk_at") else "unknown"))
    return order[0]


def _marks() -> tuple:
    """(started by Claude Code, started by Codex), from the marks each leaves in the environment of the commands it runs
    (CLAUDECODE, CLAUDE_CODE_ENTRYPOINT; CODEX_SANDBOX, CODEX_THREAD_ID and other CODEX_ names, not CODEX_HOME alone)."""
    return (bool(os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_ENTRYPOINT")),
            any(k.startswith("CODEX_") and k != "CODEX_HOME" for k in os.environ))


def chat_driven() -> bool:
    """A heuristic: an agent's session started Bonsai. It decides the reminder and the declared-protected refusal."""
    return any(_marks())


def caller_family() -> str | None:
    """Which agent started this command: "claude" or "codex"; None when neither or both (a heuristic)."""
    claude, codex = _marks()
    return None if claude == codex else ("claude" if claude else "codex")


def in_codex_sandbox() -> bool:
    """Codex's sandbox wraps this process: the network is off and Claude Code cannot reach its sign-in in the
    Keychain, so a routed job cannot work here (seen 2026-11-08: a bare "exit 1" after 0.3 s)."""
    return bool(os.environ.get("CODEX_SANDBOX")) or os.environ.get("CODEX_SANDBOX_NETWORK_DISABLED") == "1"


CODEX_SANDBOX_MESSAGE = (
    "bonsai: stopped: this command is running inside Codex's sandbox, which turns off the network and hides the "
    "Keychain, so no model job can start here. Run bonsai outside the sandbox: in Codex, approve running the "
    "command outside the sandbox when it asks (or allow it for `bonsai`); or run the same line in Terminal.")

# "The other model": a Claude agent asks a ChatGPT model, a Codex agent asks a Claude model (aliases, so
# `bonsai config` can change them).
OTHER_FAMILY = {"claude": ("codex", "sol"), "codex": ("claude", "opus")}
OTHER_WORDS = ("other", "other-family", "other-model")


def resolve_target(target: str, cfg: dict, model: str | None) -> tuple[str, str | None, str | None]:
    """(provider, login wanted, model id) from a target word: `claude` / `codex` (auto login),
    `<name>-claude` / `<name>-codex`, a model alias (`astra`: auto login for its provider), `<alias>@<name>`, or
    `other` (the family that did not start this command; `other@<name>` names the login)."""
    models = cfg.get("models") or {}
    t = target.lower()
    head, _, at = t.partition("@")
    if head in OTHER_WORDS:                  # `other` / `other@<login>`: the family that is not the one asking
        fam = caller_family()
        if fam is None:
            raise SystemExit("bonsai: `other` means the model family that is not the one asking, and bonsai cannot tell "
                             "which agent is asking here. Say `claude` or `codex` (or a model alias such as opus or sol).")
        prov, alias = OTHER_FAMILY[fam]
        mid = models[alias][1] if isinstance(models.get(alias), list) and len(models[alias]) == 2 else None
        return prov, (at or None), model or mid
    if "@" in t and t.split("@")[0] in models:
        alias, want = t.split("@", 1)
        prov, mid = models[alias]
        return prov, want, model or mid
    if t in models:
        prov, mid = models[t]
        return prov, None, model or mid
    # The provider words people use: the company, the product and the CLI name all mean the same seat.
    if t in PROVIDER_WORDS:
        return PROVIDER_WORDS[t], None, model
    for word, prov in sorted(PROVIDER_WORDS.items(), key=lambda kv: (-len(kv[0]), kv[0])):
        if t.endswith("-" + word) and len(t) > len(word) + 1:
            return prov, t[: -len(word) - 1], model
    raise SystemExit(T("bonsai: unknown target %r. Try claude, codex, {{label}}-claude, {{label}}-codex "
                       "(also {{label}}-openai, {{label}}-chatgpt, {{label}}-anthropic), personal-codex, "
                       "or a model alias (%s)") % (target, ", ".join(sorted(models))))



JSON_SCHEMA = 1


def envelope(kind: str, **payload) -> dict:
    doc = {"schema": JSON_SCHEMA, "kind": kind, "bonsai": VERSION, "profile": PROFILE.get("id") or "none", "at": _iso(_now())}
    doc.update(payload)
    return doc


def emit(doc: dict) -> None:
    print(json.dumps(doc, indent=1, sort_keys=True, ensure_ascii=False, allow_nan=False))


def _iso_or_none(ts):
    ts = _when_ts(ts)
    return _iso(ts) if ts is not None else None


def window_json(row: dict, win: str):
    used = row.get(win)
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        return None
    return {"used": used, "left": round(max(0.0, 100.0 - used), 1), "resets_at": _iso_or_none(row.get(win + "_at"))}


def login_json(row: dict) -> dict:
    q = (row.get("reading") or {}) if row.get("provider") == "claude" else row      # Claude: as Claude Code last reported
    return {"provider": row.get("provider"), "pool": row.get("pool"), "label": row.get("name"),
            "institution": bool(row.get("institution")), "state": row.get("state"), "plan": row.get("plan"),
            "account": row.get("account"), "org": row.get("org"), "workspace": row.get("workspace"),
            "weekly": window_json(q, "wk"), "five_hour": window_json(q, "5h"), "model_caps": {},
            "usage_read_at": _iso_or_none((row.get("reading") or {}).get("at"))}


def gauge_json(state: dict, cfg: dict, interval: int) -> dict:
    jobs = read_jobs(None)
    running = [j for j in jobs if "exit" not in j and not j.get("lost")]
    done = [j for j in jobs if "exit" in j]
    return envelope("gauge", probed_at=_iso_or_none(state.get("at")), interval=interval,
                    logins=[login_json(r) for r in state.get("rows", []) if isinstance(r, dict)],
                    machine=machine_stats(),
                    jobs={"running": len(running), "last": job_json(done[-1]) if done else None})


def job_json(j: dict) -> dict:
    status = ("running" if "exit" not in j and not j.get("lost") else
              "lost" if j.get("lost") else j["outcome"] if j.get("outcome") in ("timeout", "cancelled") else
              "ok" if j.get("exit") == 0 else "failed")
    return {"id": j.get("id"), "at": j.get("at"), "provider": j.get("provider"), "pool": j.get("pool"),
            "label": j.get("label"), "command": j.get("cmd"), "status": status, "exit": j.get("exit"),
            "seconds": j.get("seconds"), "finished_at": j.get("finished_at")}



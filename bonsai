def _read_json(path: str, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def private_dir(path: str) -> None:
    """A directory only this user can enter. Only for the program's own state, config and pools."""
    if os.path.islink(path):
        raise SystemExit("%s is a symlink; a private directory must be real" % path)
    os.makedirs(path, mode=0o700, exist_ok=True)
    if not IS_WIN:
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass


def replace(src: str, dst: str) -> None:
    """os.replace, retried for up to two seconds on Windows, where a file another process has open cannot be replaced."""
    for _ in range(19 if IS_WIN else 0):
        try:
            return os.replace(src, dst)
        except PermissionError:
            time.sleep(0.1)
    os.replace(src, dst)


def atomic_text(path: str, text: str) -> None:
    """Write a file in one step: a private temp file beside it, then a rename. Never truncates
    the target on the way, never follows a planted symlink."""
    path = os.path.abspath(path)
    parent = os.path.dirname(path)
    os.makedirs(parent, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".pool-", dir=parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        if not IS_WIN:
            os.chmod(tmp, 0o600)
        replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def _write_json(path: str, obj) -> None:
    private_dir(os.path.dirname(os.path.abspath(path)))
    atomic_text(path, json.dumps(obj, indent=1, sort_keys=True, allow_nan=False))


def _append_private(path: str, line: str) -> None:
    """One line onto a 0600 file that is never a symlink, under a lock (the file's `.lock` neighbour)
    around the whole write."""
    path = os.path.abspath(path)
    private_dir(os.path.dirname(path))
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    with state_lock(path + ".lock"):
        fd = os.open(path, flags, 0o600)
        try:
            if not IS_WIN:
                os.fchmod(fd, 0o600)
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)


@contextlib.contextmanager
def state_lock(path: str):
    """An exclusive inter-process lock on a private file at `path` (its directory is made private)."""
    private_dir(os.path.dirname(os.path.abspath(path)))
    flags = os.O_CREAT | os.O_RDWR
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, 0o600)
    try:
        if IS_WIN:
            import msvcrt
            os.lseek(fd, 0, 0)
            while True:
                try:
                    msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                    break
                except OSError as e:     # held by another Bonsai: wait for it, as flock does
                    if e.errno not in (errno.EACCES, getattr(errno, "EDEADLOCK", errno.EDEADLK)):
                        raise
                    time.sleep(0.2)
        else:
            import fcntl
            os.fchmod(fd, 0o600)
            fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            if IS_WIN:
                import msvcrt
                os.lseek(fd, 0, 0)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
        except Exception:
            pass
        os.close(fd)



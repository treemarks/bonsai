# The provider words people use: the company, the product, the CLI and the board's abbreviation all mean
# the same seat (ruled 2026-11-08: the company's name "works as semantically same as" the CLI's, "chatgpt
# works too", "for claude, you can take anthropic as the same").
PROVIDER_WORDS = {"claude": "claude", "anthropic": "claude", "ant": "claude",
                  "codex": "codex", "openai": "codex", "chatgpt": "codex", "gpt": "codex", "oai": "codex"}


MIN_USABLE_PCT = 10.0        # the floor at a window's start: under this much room a login waits
WINDOW_SECONDS = {"wk": 7 * 86400, "5h": 5 * 3600}
FLOOR_CURVE = 3              # the strict hold curve: most of the floor holds until the reset is near


def held_share(seconds_left, window_seconds: float, power: float) -> float:
    """The hold curve: the share of something held with `seconds_left` to a window's reset. All of it at the
    window's start, none at its reset; an unknown time left holds all of it."""
    if seconds_left is None:
        return 1.0
    t = min(1.0, max(0.0, seconds_left / window_seconds))
    return 1.0 - (1.0 - t) ** power


def floor_now(seconds_left, window: str = "wk", floor_pct: float = MIN_USABLE_PCT, power: float = FLOOR_CURVE) -> float:
    """The floor, in percent, a login's room must clear now: the full floor early in its window, shrinking to
    nothing as the reset nears, since room left at the reset is lost either way (ruled 2026-11-08: "Yes, shrink
    it", "Yes, all work"). The one definition of the floor."""
    return floor_pct * held_share(seconds_left, WINDOW_SECONDS.get(window, WINDOW_SECONDS["wk"]), power)


def room(row: dict) -> tuple:
    """(percent left, window) for the tighter of the two windows."""
    live = []
    for win in ("5h", "wk"):
        used = row.get(win)
        if isinstance(used, (int, float)) and not isinstance(used, bool) and math.isfinite(used):
            live.append((100.0 - used, win))
    return min(live) if live else (None, None)


PREFERENCES = ("soonest", "institution", "personal")


def route(state: dict, provider: str, prefer: str = "soonest", now=None) -> list:
    """The order for one provider: every login a job may start on, best first, then the ones that wait.

    `prefer`: `soonest` (the room that resets first, personal and institution alike), `institution` (institution
    seats first, then the rest), `personal` (personal logins first). A login the provider is serving (`OK`) with
    both windows read is ranked by its weekly reset; one under the floor (`floor_now`), or with nothing left, waits. A login that is only
    signed in (no usage numbers to rank on) comes after the ranked ones: jobs use it, it just has nothing to rank on. `LIMITED`
    is a stop and is not in the order."""
    now = _now() if now is None else now
    out = []
    for r in state.get("rows", []):
        if r.get("provider") != provider or r.get("mismatch"):
            continue
        if r.get("state") == "signed-in":
            out.append({**r, "left": None, "window": None, "held": False, "ranked": False,
                        "why": "signed in, not ranked on usage; jobs use it"})
            continue
        if r.get("state") != "OK" or r.get("incomplete_usage"):
            continue
        left, win = room(r)
        if left is None:
            continue
        reset = r.get("wk_at") if win == "wk" else r.get("5h_at")
        floor = floor_now((reset - now) if isinstance(reset, (int, float)) else None, win or "wk")
        held = left <= 0.0 or left < floor      # a login with nothing left waits, however near its reset
        wk = r.get("wk_at")
        out.append({**r, "left": left, "window": win, "held": held, "ranked": True, "floor": round(floor, 1),
                    "why": ("%.0f%% left in its %s window, under the %.0f%% floor now; waits" % (left, win, floor)) if held
                    else ("%.0f%% left in its %s window, weekly reset %s" % (
                        left, win, ("in " + _age(wk - now)) if isinstance(wk, (int, float)) else "unknown"))})

    def key(e):
        first = {"institution": not e.get("institution"), "personal": bool(e.get("institution"))}.get(prefer, False)
        at = e.get("wk_at") if isinstance(e.get("wk_at"), (int, float)) else math.inf
        return (e["held"], first, not e["ranked"], at, -(e["left"] or 0.0))
    out.sort(key=key)
    return out



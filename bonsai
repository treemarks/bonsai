def login_name(cfg: dict, pool: str) -> str:
    entry = (cfg.get("logins") or {}).get(pool) or {}
    if isinstance(entry.get("name"), str) and entry["name"]:
        return entry["name"]
    if pool == "default":
        return "personal"
    local, _, domain = pool.partition("@")
    for suffix, label in (PROFILE.get("domains") or {}).items():
        if domain and suffix and domain.lower().endswith(suffix.lower()):
            return label
    if domain:
        return domain.split(".")[0]
    return pool



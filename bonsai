def _sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


# Where each agent reads a user skill: Claude Code ~/.claude/skills, Codex ~/.agents/skills (the user folder OpenAI
# documents). The same SKILL.md goes to both.
SKILL_AGENTS = (("Claude Code", "claude", (".claude", "skills", "bonsai-route", "SKILL.md")),
                ("Codex", "codex", (".agents", "skills", "bonsai-route", "SKILL.md")))


def skill_targets() -> list:
    """(agent, path) for each agent on this machine (its folder exists or its CLI answers); Claude Code when
    neither is found."""
    out = [(name, os.path.join(HOME, *parts)) for name, cli, parts in SKILL_AGENTS
           if os.path.isdir(os.path.join(HOME, "." + cli)) or which_cli(cli)]
    return out or [(SKILL_AGENTS[0][0], os.path.join(HOME, *SKILL_AGENTS[0][2]))]


def skill_state(path: str) -> str:
    if not os.path.isfile(path):
        return "missing"
    try:
        with open(path, encoding="utf-8") as f:
            return "matches" if f.read() == SKILL else "differs"
    except OSError:
        return "differs"


def cmd_install_skill(a, cfg) -> int:
    ensure_notice(cfg, "install-skill")
    written = (_read_json(os.path.join(STATE, "skill.json"), {}) or {}).get("sha256")
    rc, wrote = 0, []
    for agent, path in skill_targets():
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.isfile(path):
            with open(path, encoding="utf-8") as f:
                current = f.read()
            if current == SKILL:
                print("%s is already this version's skill (%s)" % (path, agent))
                continue
            if _sha256(current) not in PUBLISHED_SKILLS and _sha256(current) != written:
                atomic_text(path + ".new", SKILL)
                print("NOT UPDATED: %s was edited after Bonsai wrote it. %s keeps using it. This version's skill is\n"
                      "at %s.new: compare the two, replace the installed file when ready, then restart %s."
                      % (path, agent, path, agent))
                rc = 2
                continue
            atomic_text(path + ".prev", current)
        atomic_text(path, SKILL)
        wrote.append((agent, path))
    if wrote:
        _write_json(os.path.join(STATE, "skill.json"), {"sha256": _sha256(SKILL), "version": VERSION})
        for agent, path in wrote:
            print("wrote %s%s; restart %s so it reads it" % (
                path, (" (the previous one is at %s.prev)" % path) if os.path.isfile(path + ".prev") else "", agent))
        print("Try: \"get an adversarial pass on this from the other model\". In Codex, approve running bonsai outside\n"
              "the sandbox when it asks: a routed job needs the network and the Keychain.\n"
              "Read the file once: it is what your agent will do with the words. It tells the agent to stop when it recognizes\n"
              "protected data; Bonsai does not detect protected information itself, and undeclared data is routed. If you\n"
              "will use Bonsai with university data, someone in your unit should review this file first%s."
              % T("{{p:skill_review_note}}"))
    return rc


def _self_dir() -> str:
    """The folder this `bonsai` file lives in, with the symlink in ~/.local/bin resolved."""
    return os.path.dirname(os.path.realpath(globals().get("__file__") or sys.argv[0] or "."))


def repo_dir() -> str | None:
    """The checkout this `bonsai` runs from: the folder of the file when it is a git work tree (a `.git` directory, or
    the `.git` file a linked worktree carries)."""
    here = _self_dir()
    return here if os.path.exists(os.path.join(here, ".git")) else None


# Environment that points git at another repository or configuration. `git -C` does not neutralize
# these; an update must not act on a repository other than the one it names (Astra, sign-in pass).
GIT_REDIRECT_VARS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
                     "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CONFIG", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS")
FRESH_COPY = ("  mv %(d)s %(d)s-old\n  git clone https://github.com/treemarks/bonsai %(d)s\n  bonsai doctor\n"
              "  bonsai install-skill")


def cmd_update(a, cfg) -> int:
    """Fetch, show the commits that would arrive, and fast-forward only on a yes."""
    d = repo_dir()
    if not d:
        raise SystemExit("bonsai: this copy (%s) is not a git checkout, so it cannot pull. Keep it; get a newer "
                         "copy into a different, empty folder (git clone https://github.com/treemarks/bonsai "
                         "<new folder>), check it with `<new folder>/bonsai doctor`, then point ~/.local/bin/bonsai "
                         "at it." % _self_dir())
    if any(k in os.environ for k in GIT_REDIRECT_VARS):
        print("bonsai: update stopped: this shell overrides git's repository or configuration (%s). Run the update "
              "from a new Terminal window without those overrides." % ", ".join(k for k in GIT_REDIRECT_VARS if k in os.environ),
              file=sys.stderr)
        return 2
    git = shutil.which("git")
    if not git:
        raise SystemExit("bonsai: git is not installed. " + INSTALL["git"]["windows" if IS_WIN else "darwin"])

    def g(*args):
        return subprocess.run([git, "-C", d, *args], capture_output=True, encoding="utf-8", errors="replace")

    branch = g("symbolic-ref", "-q", "--short", "HEAD")
    if branch.returncode != 0:
        print("bonsai: update stopped: %s is not on a branch (detached), so there is nothing to pull onto. Keep this "
              "folder; get a fresh copy into a different, empty folder." % d, file=sys.stderr)
        return 2
    before_commit = g("rev-parse", "--short", "HEAD").stdout.strip() or "?"
    print("bonsai: updating %s (bonsai %s, %s, branch %s)" % (d, VERSION, before_commit, branch.stdout.strip()))
    sys.stdout.flush()
    rc = subprocess.call([git, "-C", d, "fetch", "--quiet"])
    if rc != 0:
        print("bonsai: git fetch did not complete (exit %d); nothing of yours was changed. If git mentioned the network, a "
              "proxy or a certificate, the download could not reach GitHub from this network; do not disable certificate "
              "checks." % rc, file=sys.stderr)
        return rc
    upstream = g("rev-parse", "--short", "@{u}")
    if upstream.returncode != 0:
        print("bonsai: update stopped: branch %s follows no remote branch, so there is nothing to pull." % branch.stdout.strip(),
              file=sys.stderr)
        return 2
    if g("merge-base", "HEAD", "@{u}").returncode != 0:
        print("bonsai: update stopped: this copy's history shares no commit with the published one (it was cloned "
              "before the public history was rewritten). Get a fresh copy; your logins and settings stay where they are:\n"
              + FRESH_COPY % {"d": shlex.quote(d)}, file=sys.stderr)
        return 2
    target = g("rev-parse", "@{u}").stdout.strip()            # the commit shown is the commit merged
    url = g("ls-remote", "--get-url").stdout.strip()
    shown = re.split(r"[?#]", re.sub(r"//[^/@]*@", "//", url))[0]     # never print a token: no userinfo, query or fragment
    print("bonsai: from %s, commit %s" % (display_text(shown, 120), target[:12]))
    if not re.fullmatch(r"(https://github\.com/|git@github\.com:|ssh://git@github\.com/)treemarks/bonsai(\.git)?/?", url):
        print("bonsai: note: that is not github.com/treemarks/bonsai; update only if you chose that source", file=sys.stderr)
    if getattr(a, "to", None) is not None and not (re.fullmatch(r"[0-9a-f]{7,40}", a.to) and target.startswith(a.to)):
        print("bonsai: update stopped: the published commit is now %s, not %s you reviewed; run the dry run again"
              % (target[:12], a.to), file=sys.stderr)
        return 2
    commits = [ln for ln in g("log", "--oneline", "HEAD..%s" % target).stdout.splitlines() if ln.strip()]
    if not commits:
        print("bonsai: already current (%s, %s)" % (VERSION, before_commit))
        return 0
    print("bonsai: %d commit%s would arrive:" % (len(commits), "" if len(commits) == 1 else "s"))
    for ln in commits[:40]:
        print("  " + display_text(ln, 200))
    if len(commits) > 40:
        print("  ... and %d more" % (len(commits) - 40))
    if a.dry_run:
        print("bonsai: dry run; nothing was changed")
        return 0
    if not a.yes:
        if not sys.stdin.isatty() or input("Type  yes  to update to these: ").strip().lower() != "yes":
            print("bonsai: not updated. Read the list, then run `bonsai update --yes --to %s`." % target[:12], file=sys.stderr)
            return 1
    rc = subprocess.call([git, "-C", d, "merge", "--ff-only", "--quiet", target])
    if rc != 0:
        print("bonsai: git merge --ff-only did not complete (exit %d); nothing of yours was changed. If git mentioned local "
              "changes, files in %s were edited on this Mac: keep or review them (`git -C %s status` lists them) "
              "before updating again." % (rc, d, shlex.quote(d)), file=sys.stderr)
        return rc
    r = subprocess.run([sys.executable, os.path.join(d, "bonsai"), "--version"], capture_output=True, encoding="utf-8", errors="replace")
    if r.returncode != 0 or not r.stdout.strip().startswith("bonsai "):
        print("bonsai: files were updated, but the new Bonsai could not report its version. The update is incomplete; "
              "keep this folder and ask for help at github.com/treemarks/bonsai/issues.", file=sys.stderr)
        return 1
    after_commit = g("rev-parse", "--short", "HEAD").stdout.strip() or "?"
    print("bonsai: %s (%s) -> %s (%s). Now run `bonsai install-skill` and restart Claude Code."
          % (VERSION, before_commit, r.stdout.strip().split()[-1], after_commit))
    return 0


def cmd_config(a, cfg) -> int:
    if a.set:
        changes = []
        for kv in a.set:
            key, _, val = kv.partition("=")
            try:
                val = json.loads(val)
            except ValueError:
                pass
            # `logins.<email>` and `models.<alias>` keys hold dots of their own: split once.
            changes.append((key.split(".", 1) if key.split(".", 1)[0] in ("logins", "models") else key.split("."), val))
            if key == "prefer" and val not in PREFERENCES:
                raise SystemExit("bonsai: prefer is one of %s" % ", ".join(PREFERENCES))

        def apply(fresh):
            for parts, val in changes:
                node = fresh
                for part in parts[:-1]:
                    node = node.setdefault(part, {})
                node[parts[-1]] = val
        # The change goes into the config as it is on disk now, under the lock a sign-in takes too.
        fresh = update_config(apply)
        cfg.clear()
        cfg.update(fresh)
    bad = validate_config(cfg)
    shown = {k: v for k, v in cfg.items() if k in CONFIG_SCHEMA and k not in bad and k not in ("default_kind", "acknowledged")}
    print(json.dumps(shown, indent=1, sort_keys=True))
    if bad:
        print("bonsai: not shown, unknown or malformed: %s" % ", ".join(sorted(display_text(k, 40) for k in bad)), file=sys.stderr)
        return 1
    return 0



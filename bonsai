# ── small helpers ────────────────────────────────────────────────────────────────

def _now() -> float:
    return time.time()


def _iso(ts: float) -> str:
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _when_ts(v) -> float | None:
    """A provider timestamp (epoch seconds, epoch milliseconds or ISO-8601) as epoch seconds."""
    if v is None:
        return None
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return float(v) / 1000.0 if v > 1e11 else float(v)
    if isinstance(v, str):
        s = v.strip()
        if re.fullmatch(r"\d+(\.\d+)?", s):
            return _when_ts(float(s))
        try:
            if s.endswith("Z"):
                s = s[:-1] + "+00:00"
            return dt.datetime.fromisoformat(s).timestamp()
        except ValueError:
            return None
    return None


def _age(seconds: float | None) -> str:
    """Whole minutes at least, never seconds (a Treemarks board rule worth keeping)."""
    if seconds is None:
        return "·"
    s = max(0, int(seconds))
    if s < 60:
        return "<1m"
    m = s // 60
    if m < 60:
        return "%dm" % m
    h = m // 60
    if h < 24:
        return "%dh%02dm" % (h, m % 60)
    d = h // 24
    return "%dd%dh" % (d, h % 24)


def _pct(v) -> float | None:
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    return max(0.0, min(100.0, float(v)))


def _jwt_claims(tok: str) -> dict:
    """A JWT's claims, decoded locally for labels only (no signature check, no authz)."""
    try:
        payload = tok.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload))
    except Exception:
        return {}


def _read_json(path: str, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def _write_json(path: str, obj) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1, sort_keys=True)
    os.replace(tmp, path)


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    saved = _read_json(CONFIG_PATH, {})
    for k, v in saved.items():
        if isinstance(v, dict) and isinstance(cfg.get(k), dict):
            cfg[k].update(v)
        else:
            cfg[k] = v
    return cfg


def save_config(cfg: dict) -> None:
    _write_json(CONFIG_PATH, cfg)


_CFG: dict = {}


def cfg_flag(section: str, key: str) -> bool:
    return bool(((_CFG.get(section) or {}).get(key, True)))


# ── pools: where each login lives ────────────────────────────────────────────────

def pool_dir(provider: str, pool: str) -> str:
    if pool == "default":
        return os.path.join(POOLS_HOME, ".claude" if provider == "claude" else ".codex")
    root = ".claude-pools" if provider == "claude" else ".codex-pools"
    return os.path.join(POOLS_HOME, root, pool)


def keychain_service(cfg_dir: str, is_default: bool) -> str:
    """Claude Code keeps each config dir's OAuth blob in the login Keychain under
    `Claude Code-credentials` (for ~/.claude) or `Claude Code-credentials-<sha256(dir)[:8]>`."""
    if is_default:
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(cfg_dir.encode()).hexdigest()[:8]


def claude_blob(cfg_dir: str, is_default: bool) -> tuple[dict | None, str]:
    """(credential blob, state). state: ok | no-login | locked | bad-credfile.

    Claude Code keeps the OAuth blob in `.credentials.json` inside the config dir on Windows and
    Linux, and in the login Keychain on macOS. A blob with an empty access token is a signed-out
    stub the CLI leaves behind, so it reads no-login."""
    cred = os.path.join(cfg_dir, ".credentials.json")
    if os.path.isfile(cred) and os.path.getsize(cred) > 0:
        d = _read_json(cred, None)
        return _blob_state(d)
    if not IS_MAC:
        return None, "no-login"
    svc = keychain_service(cfg_dir, is_default)
    try:
        out = subprocess.run(["security", "find-generic-password", "-s", svc, "-w"],
                             capture_output=True, text=True, timeout=10)
    except Exception:
        return None, "no-login"
    if out.returncode == 0 and out.stdout.strip():
        try:
            return _blob_state(json.loads(out.stdout))
        except Exception:
            return None, "bad-credfile"
    if out.returncode == 36:
        return None, "locked"       # the login keychain is locked to this session (ssh)
    try:
        meta = subprocess.run(["security", "find-generic-password", "-s", svc],
                              capture_output=True, text=True, timeout=10)
        if meta.returncode == 0:
            return None, "locked"   # the item exists; its secret is not readable here
    except Exception:
        pass
    return None, "no-login"


def _blob_state(d) -> tuple[dict | None, str]:
    if not isinstance(d, dict):
        return None, "bad-credfile"
    o = d.get("claudeAiOauth")
    if not isinstance(o, dict):
        return None, "bad-credfile"
    if not o.get("accessToken"):
        return None, "no-login"
    return d, "ok"


def discover_pools() -> list[tuple[str, str, str]]:
    """Every (provider, pool, dir) that looks signed in or set up on this machine."""
    out = []
    for provider in ("claude", "codex"):
        d = pool_dir(provider, "default")
        if os.path.isdir(d):
            out.append((provider, "default", d))
        root = os.path.dirname(pool_dir(provider, "x"))
        if os.path.isdir(root):
            for name in sorted(os.listdir(root)):
                p = os.path.join(root, name)
                if os.path.isdir(p) and not name.startswith("."):
                    out.append((provider, name, p))
    return out


def login_name(cfg: dict, pool: str) -> str:
    entry = (cfg.get("logins") or {}).get(pool) or {}
    if entry.get("name"):
        return entry["name"]
    if pool == "default":
        return "personal"
    local, _, domain = pool.partition("@")
    if domain and domain.lower().endswith(("stanford.edu",)):
        return "stanford"
    if domain:
        return domain.split(".")[0]
    return pool


def is_institution(cfg: dict, pool: str) -> bool:
    return bool(((cfg.get("logins") or {}).get(pool) or {}).get("institution"))


# ── the probe: one login's room ──────────────────────────────────────────────────

def _get(url: str, headers: dict) -> dict:
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        return json.loads(r.read())


def _claude_headers(token: str) -> dict:
    """Bonsai says who it is. It never presents itself as Claude Code: the read is a usage
    look-up with the token the CLI stored, made under Bonsai's own name, and it is the only
    thing Bonsai ever does with that token."""
    return {"Authorization": "Bearer " + token, "anthropic-beta": "oauth-2025-04-20",
            "Accept": "application/json", "User-Agent": USER_AGENT}


def parse_claude_usage(d: dict) -> dict:
    """The fields the board needs from GET /api/oauth/usage: 5h and weekly utilization (0-100,
    percent used) with their resets, and any per-model weekly caps."""
    row: dict = {}
    for key, out in (("five_hour", "5h"), ("seven_day", "wk")):
        w = d.get(key)
        if isinstance(w, dict):
            row[out] = _pct(w.get("utilization"))
            row[out + "_at"] = _when_ts(w.get("resets_at"))
    caps = {}
    for lim in d.get("limits") or []:
        if not isinstance(lim, dict) or lim.get("kind") != "weekly_scoped":
            continue
        name = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
        if name:
            caps[str(name).lower()] = {"used": _pct(lim.get("utilization")),
                                      "at": _when_ts(lim.get("resets_at") or lim.get("reset_at"))}
    if caps:
        row["model_caps"] = caps
    return row


def parse_codex_usage(d: dict) -> dict:
    """The fields the board needs from GET /backend-api/wham/usage: the two windows by their
    length (≤6h is the five-hour window, the other the weekly one), percent used and resets."""
    row: dict = {"plan": d.get("plan_type")}
    rl = d.get("rate_limit") or {}
    for w in (rl.get("primary_window"), rl.get("secondary_window")):
        if not isinstance(w, dict):
            continue
        secs = w.get("limit_window_seconds") or 0
        out = "5h" if secs <= 6 * 3600 else "wk"
        row[out] = _pct(w.get("used_percent"))
        row[out + "_at"] = _when_ts(w.get("reset_at"))
    if rl.get("limit_reached"):
        row["limited"] = True
    return row


def probe_claude(pool: str, cfg_dir: str) -> dict:
    row = {"pool": pool, "provider": "claude", "state": "no-login"}
    blob, state = claude_blob(cfg_dir, pool == "default")
    if state != "ok":
        row["state"] = state
        return row
    tok = (blob.get("claudeAiOauth") or {}).get("accessToken")
    if not tok:
        row["state"] = "bad-credfile"
        return row
    rexp = _when_ts((blob.get("claudeAiOauth") or {}).get("refreshTokenExpiresAt"))
    if rexp:
        row["login_expires_at"] = rexp
    try:
        prof = _get("https://api.anthropic.com/api/oauth/profile", _claude_headers(tok))
        org = prof.get("organization") or {}
        row["account"] = (prof.get("account") or {}).get("email")
        row["plan"] = str(org.get("organization_type") or "").replace("claude_", "") or None
        row["org"] = org.get("name")
        if row["plan"] == "free":
            row["state"] = "no-plan"
            return row
        if not (cfg_flag("usage_reads", "claude") or row["plan"] not in ("pro", "max", "free", "ultra", None)):
            row["state"] = "signed-in"      # a consumer login with usage reads turned off (README §Terms)
            return row
        row.update(parse_claude_usage(_get("https://api.anthropic.com/api/oauth/usage", _claude_headers(tok))))
        row["state"] = "OK"
    except urllib.error.HTTPError as e:
        row["state"] = "re-login" if e.code == 401 else "http-%d" % e.code
        if e.code == 429:
            row["retry_after"] = _now() + float(e.headers.get("Retry-After") or 900)
    except (urllib.error.URLError, TimeoutError, socket.timeout):
        row["state"] = "offline"
    except Exception as e:
        row["state"] = "error: " + type(e).__name__
    return row


def probe_codex(pool: str, cfg_dir: str) -> dict:
    row = {"pool": pool, "provider": "codex", "state": "no-login"}
    auth_path = os.path.join(cfg_dir, "auth.json")
    if not (os.path.isfile(auth_path) and os.path.getsize(auth_path) > 0):
        return row
    auth = _read_json(auth_path, {})
    t = auth.get("tokens", auth) if isinstance(auth, dict) else {}
    if not t.get("access_token"):
        row["state"] = "bad-credfile"
        return row
    row["account"] = _jwt_claims(t.get("id_token") or "").get("email")
    exp = _jwt_claims(t["access_token"]).get("exp")
    if isinstance(exp, (int, float)) and exp <= _now():
        row["state"] = "token-expired"      # the CLI refreshes it on its next real use
        return row
    if not cfg_flag("usage_reads", "codex"):
        row["state"] = "signed-in"
        return row
    try:
        d = _get("https://chatgpt.com/backend-api/wham/usage", {
            "Authorization": "Bearer " + t["access_token"],
            "ChatGPT-Account-Id": t.get("account_id", ""),
            "Accept": "application/json", "User-Agent": USER_AGENT})
        row.update(parse_codex_usage(d))
        row["state"] = "LIMITED" if row.pop("limited", False) else "OK"
    except urllib.error.HTTPError as e:
        row["state"] = "re-login" if e.code == 401 else "http-%d" % e.code
        if e.code == 429:
            row["retry_after"] = _now() + float(e.headers.get("Retry-After") or 900)
    except (urllib.error.URLError, TimeoutError, socket.timeout):
        row["state"] = "offline"
    except Exception as e:
        row["state"] = "error: " + type(e).__name__
    return row


def probe_all(cfg: dict, previous: dict | None = None) -> dict:
    """Every pool, once. A login under a 429 back-off keeps its last row until the back-off ends."""
    prev_rows = {(r["provider"], r["pool"]): r for r in (previous or {}).get("rows", [])}
    rows = []
    for provider, pool, d in discover_pools():
        old = prev_rows.get((provider, pool))
        if old and old.get("retry_after") and old["retry_after"] > _now():
            rows.append(old)
            continue
        row = probe_claude(pool, d) if provider == "claude" else probe_codex(pool, d)
        row["name"] = login_name(cfg, pool)
        row["institution"] = is_institution(cfg, pool)
        if row["state"] not in ("OK", "LIMITED") and old and old.get("state") in ("OK", "LIMITED"):
            row["last_good"] = {k: old.get(k) for k in ("5h", "5h_at", "wk", "wk_at", "plan", "account")}
        rows.append(row)
    return {"at": _now(), "rows": rows}


def cache_path() -> str:
    return os.path.join(STATE, "last_probe.json")


def read_cache() -> dict | None:
    c = _read_json(cache_path(), None)
    return c if isinstance(c, dict) and "rows" in c else None


def annotate(state: dict, cfg: dict) -> dict:
    """Lay the config's labels over the rows: the name and the institution flag are read from the
    config each time, so a `bonsai config --set` or `bonsai login --institution` takes effect on the
    next render, not the next probe."""
    for r in state.get("rows", []):
        r["name"] = login_name(cfg, r["pool"])
        r["institution"] = is_institution(cfg, r["pool"])
    return state


def refresh(cfg: dict, force: bool = False) -> dict:
    cached = read_cache()
    interval = max(180, int(cfg.get("interval") or DEFAULT_INTERVAL))
    if cached and not force and _now() - cached.get("at", 0) < interval:
        return annotate(cached, cfg)
    state = annotate(probe_all(cfg, cached), cfg)
    _write_json(cache_path(), state)
    with open(os.path.join(STATE, "history.jsonl"), "a") as f:
        for r in state["rows"]:
            if r.get("state") in ("OK", "LIMITED"):
                f.write(json.dumps({"at": _iso(state["at"]), "pool": r["pool"], "provider": r["provider"],
                                    "wk": r.get("wk"), "5h": r.get("5h")}) + "\n")
    return state


# ── routing: which login a job starts on ─────────────────────────────────────────

def room(row: dict) -> tuple[float | None, str | None]:
    """(percent left, window) for the tighter of the two windows."""
    live = []
    for win in ("5h", "wk"):
        used = row.get(win)
        if isinstance(used, (int, float)):
            live.append((100.0 - used, win))
    return min(live) if live else (None, None)


def route(state: dict, provider: str, kind: str = "general") -> list[dict]:
    """The order for one provider: eligible logins, the room that expires soonest first.

    kind=general: personal logins only — an institution seat never carries everyday work.
    kind=sensitive: institution seats only — data under your school's agreements never
    reaches a personal login. Names in a `bonsai job <target>` bypass `kind` on purpose:
    "route this to my stanford codex" means exactly that login."""
    out = []
    for r in state.get("rows", []):
        if r.get("provider") != provider or r.get("state") not in ("OK", "LIMITED"):
            continue
        if kind == "sensitive" and not r.get("institution"):
            continue
        if kind == "general" and r.get("institution"):
            continue
        left, win = room(r)
        if left is None:
            continue
        held = left < MIN_USABLE_PCT
        out.append({**r, "left": left, "window": win, "held": held,
                    "why": ("under %d%% in its %s window; waits" % (MIN_USABLE_PCT, win)) if held
                    else ("%.0f%% left in its %s window, weekly reset in %s" % (left, win, _age((r.get("wk_at") or 0) - _now())))})
    out.sort(key=lambda e: (e["held"], e.get("wk_at") or float("inf"), -e["left"]))
    return out


def pick(state: dict, provider: str, kind: str, want: str | None, cfg: dict) -> dict:
    """Resolve `want` (None/auto, a login name like `stanford`, an email or its prefix) to a row."""
    rows = [r for r in state.get("rows", []) if r.get("provider") == provider]
    if want and want not in ("auto", ""):
        w = want.lower()
        hits = [r for r in rows if r["pool"].lower() == w or r.get("name", "").lower() == w
                or r["pool"].lower().startswith(w) or (r.get("account") or "").lower().startswith(w)]
        if not hits:
            raise SystemExit("bonsai: no %s login called %r is set up here; `bonsai doctor` lists them" % (provider, want))
        if len(hits) > 1:
            raise SystemExit("bonsai: %r matches several %s logins: %s" % (want, provider, ", ".join(r["pool"] for r in hits)))
        r = hits[0]
        if r.get("state") not in ("OK", "LIMITED"):
            print("bonsai: note: %s/%s reads %s on the last probe; trying it anyway" % (provider, r["pool"], r["state"]), file=sys.stderr)
        return r
    order = route(state, provider, kind)
    if not order:
        raise SystemExit("bonsai: no %s login is eligible for %s work right now (`bonsai route %s`)" % (provider, kind, provider))
    if order[0]["held"]:
        print("bonsai: note: every eligible %s login is under %d%%; taking the one with most room" % (provider, MIN_USABLE_PCT), file=sys.stderr)
    return order[0]


def child_env(provider: str, pool: str) -> dict:
    """The environment a job runs with: this pool's config dir, and none of the marks a
    parent Claude Code or Codex session leaves (a nested `claude` refuses to start under them)."""
    env = {k: v for k, v in os.environ.items()
           if k not in ("CLAUDECODE", "CLAUDE_CONFIG_DIR", "CODEX_HOME", "CLAUDE_CODE_ENTRYPOINT")}
    env["CLAUDE_CONFIG_DIR" if provider == "claude" else "CODEX_HOME"] = pool_dir(provider, pool)
    env["BONSAI_POOL"] = pool
    return env


# ── jobs: a ledger the board can read ────────────────────────────────────────────

def jobs_path() -> str:
    return os.path.join(STATE, "jobs.jsonl")


def record_job(entry: dict) -> None:
    os.makedirs(STATE, exist_ok=True)
    with open(jobs_path(), "a") as f:
        f.write(json.dumps(entry) + "\n")


def read_jobs(limit: int = 200) -> list[dict]:
    try:
        with open(jobs_path()) as f:
            lines = f.readlines()[-limit * 2:]
    except FileNotFoundError:
        return []
    by_id: dict = {}
    for ln in lines:
        try:
            e = json.loads(ln)
        except ValueError:
            continue
        by_id.setdefault(e["id"], {}).update(e)
    jobs = list(by_id.values())
    for j in jobs:
        if "exit" not in j and not _pid_alive(j.get("pid")):
            j["lost"] = True
    return jobs[-limit:]


def _pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


def run_job(argv: list[str], provider: str, pool: str, label: str, stdin_text: str | None = None,
            cwd: str | None = None) -> int:
    jid = uuid.uuid4().hex[:8]
    record_job({"id": jid, "at": _iso(_now()), "provider": provider, "pool": pool, "label": label,
                "cmd": argv[0], "pid": os.getpid()})
    t0 = _now()
    try:
        p = subprocess.run(argv, env=child_env(provider, pool), cwd=cwd,
                           input=stdin_text, text=True if stdin_text is not None else None)
        code = p.returncode
    except KeyboardInterrupt:
        code = 130
    except FileNotFoundError:
        print("bonsai: %s is not installed (or not on PATH)" % argv[0], file=sys.stderr)
        code = 127
    record_job({"id": jid, "exit": code, "seconds": round(_now() - t0, 1)})
    return code


